(load "Test.carp")
(load "../web.carp")
(use Test)

; Build a masked client frame for testing decode-frame.
; Opcode 1 (text), mask key [0x37 0xfa 0x21 0x3d].
(defn make-masked-text-frame [msg]
  (let-do [bytes (String.to-bytes msg)
           len (Array.length &bytes)
           frame (the (Array Byte) [])
           mask [(Byte.from-int 55)
                 (Byte.from-int 250)
                 (Byte.from-int 33)
                 (Byte.from-int 61)]]
    ; FIN + text
    (Array.push-back! &frame (Byte.from-int 129))
    ; MASK bit + length (assume < 126)
    (Array.push-back! &frame (Byte.from-int (+ 128 len)))
    ; Mask key
    (for [i 0 4] (Array.push-back! &frame @(Array.unsafe-nth &mask i)))
    ; Masked payload
    (for [i 0 len]
      (Array.push-back! &frame
                        (Byte.from-int
                          (bit-xor
                            (Byte.to-int @(Array.unsafe-nth &bytes i))
                            (Byte.to-int @(Array.unsafe-nth &mask (Int.mod i 4)))))))
    frame))

; Build a masked client frame for testing decode-frame with binary opcode.
; Opcode 2 (binary), mask key [0x37 0xfa 0x21 0x3d].
(defn make-masked-binary-frame [data]
  (let-do [len (Array.length data)
           frame (the (Array Byte) [])
           mask [(Byte.from-int 55)
                 (Byte.from-int 250)
                 (Byte.from-int 33)
                 (Byte.from-int 61)]]
    ; FIN + binary
    (Array.push-back! &frame (Byte.from-int 130))
    ; MASK bit + length (assume < 126)
    (Array.push-back! &frame (Byte.from-int (+ 128 len)))
    ; Mask key
    (for [i 0 4] (Array.push-back! &frame @(Array.unsafe-nth &mask i)))
    ; Masked payload
    (for [i 0 len]
      (Array.push-back! &frame
                        (Byte.from-int
                          (bit-xor (Byte.to-int @(Array.unsafe-nth data i))
                                   (Byte.to-int @(Array.unsafe-nth &mask
                                                                   (Int.mod i 4)))))))
    frame))

; Build a masked client frame with explicit FIN and opcode.
; Mask key [0x37 0xfa 0x21 0x3d].
(defn make-masked-frame [fin opcode data]
  (let-do [len (Array.length data)
           frame (the (Array Byte) [])
           mask [(Byte.from-int 55)
                 (Byte.from-int 250)
                 (Byte.from-int 33)
                 (Byte.from-int 61)]
           b0 (if fin (+ 128 opcode) opcode)]
    (Array.push-back! &frame (Byte.from-int b0))
    (Array.push-back! &frame (Byte.from-int (+ 128 len)))
    (for [i 0 4] (Array.push-back! &frame @(Array.unsafe-nth &mask i)))
    (for [i 0 len]
      (Array.push-back! &frame
                        (Byte.from-int
                          (bit-xor (Byte.to-int @(Array.unsafe-nth data i))
                                   (Byte.to-int @(Array.unsafe-nth &mask
                                                                   (Int.mod i 4)))))))
    frame))

(deftest test
  ; ---------------------------------------------------------------------------
  ; Base64 encoding
  ; ---------------------------------------------------------------------------

  (assert-equal test "" &(Base64.encode &(String.to-bytes &@"")) "Base64 empty")

  (assert-equal test
    "Zg=="
    &(Base64.encode &(String.to-bytes &@"f"))
    "Base64 single byte")

  (assert-equal test
    "Zm8="
    &(Base64.encode &(String.to-bytes &@"fo"))
    "Base64 two bytes")

  (assert-equal test
    "Zm9v"
    &(Base64.encode &(String.to-bytes &@"foo"))
    "Base64 three bytes")

  (assert-equal test
    "Zm9vYmFy"
    &(Base64.encode &(String.to-bytes &@"foobar"))
    "Base64 six bytes")

  ; ---------------------------------------------------------------------------
  ; SHA-1 + Base64
  ; ---------------------------------------------------------------------------

  (assert-equal test
    "qZk+NkcGgWq6PiVxeFDCbJzQ2J0="
    &(Base64.encode &(SHA1.digest &(String.to-bytes &@"abc")))
    "SHA1 of 'abc'")

  (assert-equal test
    "2jmj7l5rSw0yVb/vlWAYkK/YBwk="
    &(Base64.encode &(SHA1.digest &(String.to-bytes &@"")))
    "SHA1 of empty string")

  ; ---------------------------------------------------------------------------
  ; WebSocket accept key (RFC 6455 section 4.2.2 example)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
    &(ws-accept-key "dGhlIHNhbXBsZSBub25jZQ==")
    "accept key matches RFC 6455 example")

  ; ---------------------------------------------------------------------------
  ; Frame encoding (server-to-client, no mask)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    2
    (let [f (WebSocket.encode-text "")] (Array.length &f))
    "encode-text empty is 2 bytes (header only)")

  (assert-equal test
    (Byte.from-int 129)
    ; 0x81 = FIN + text
    (let [f (WebSocket.encode-text "hi")] @(Array.unsafe-nth &f 0))
    "encode-text sets FIN + opcode 1")

  (assert-equal test
    (Byte.from-int 2)
    (let [f (WebSocket.encode-text "hi")] @(Array.unsafe-nth &f 1))
    "encode-text sets payload length")

  (assert-equal test
    "hi"
    &(let-do [f (WebSocket.encode-text "hi")
              payload (the (Array Byte) [])]
      (for [i 2 (Array.length &f)]
        (Array.push-back! &payload @(Array.unsafe-nth &f i)))
      (String.from-bytes &payload))
    "encode-text payload matches input")

  ; ---------------------------------------------------------------------------
  ; Frame decoding (client-to-server, masked)
  ; ---------------------------------------------------------------------------

  (assert-true test
    (Maybe.just? &(WebSocket.decode-frame &(make-masked-text-frame "hello") 0))
    "decode-frame succeeds on complete frame")

  (assert-equal test
    1
    (match (WebSocket.decode-frame &(make-masked-text-frame "hello") 0)
      (Maybe.Just f) @(WSFrame.opcode &f)
      (Maybe.Nothing) -1)
    "decode-frame returns opcode 1 for text")

  (assert-equal test
    "hello"
    &(match (WebSocket.decode-frame &(make-masked-text-frame "hello") 0)
      (Maybe.Just f) (String.from-bytes (WSFrame.payload &f))
      (Maybe.Nothing) @"FAIL")
    "decode-frame unmasks payload correctly")

  (assert-equal test
    11
    ; 2 header + 4 mask + 5 payload
    (match (WebSocket.decode-frame &(make-masked-text-frame "hello") 0)
      (Maybe.Just f) @(WSFrame.consumed &f)
      (Maybe.Nothing) -1)
    "decode-frame reports correct consumed bytes")

  (assert-true test
    (Maybe.nothing?
      &(WebSocket.decode-frame &(the (Array Byte) [(Byte.from-int 129)]) 0))
    "decode-frame returns Nothing for incomplete buffer")

  ; ---------------------------------------------------------------------------
  ; Encode/decode round-trip (encode server frame, decode without mask)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    "round-trip"
    &(let [encoded (WebSocket.encode-text "round-trip")]
      (match (WebSocket.decode-frame &encoded 0)
        (Maybe.Just f) (String.from-bytes (WSFrame.payload &f))
        (Maybe.Nothing) @"FAIL"))
    "server frame round-trips through decode")

  ; ---------------------------------------------------------------------------
  ; Extended length encoding (16-bit)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    (Byte.from-int 126)
    (let [f (WebSocket.encode-text &(String.allocate 200 \x))]
      @(Array.unsafe-nth &f 1))
    "encode-text uses 16-bit length for >125 bytes")

  (assert-equal test
    200
    (let [f (WebSocket.encode-text &(String.allocate 200 \x))]
      (- (Array.length &f) 4))
    "encode-text 16-bit payload length correct")

  ; ---------------------------------------------------------------------------
  ; Decode at non-zero offset (multiple frames in buffer)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    "world"
    &(let-do [f1 (make-masked-text-frame "hello")
              f2 (make-masked-text-frame "world")
              buf (the (Array Byte) [])]
      (for [i 0 (Array.length &f1)]
        (Array.push-back! &buf @(Array.unsafe-nth &f1 i)))
      (for [i 0 (Array.length &f2)]
        (Array.push-back! &buf @(Array.unsafe-nth &f2 i)))
      (let [off (Array.length &f1)]
        (match (WebSocket.decode-frame &buf off)
          (Maybe.Just f) (String.from-bytes (WSFrame.payload &f))
          (Maybe.Nothing) @"FAIL")))
    "decode-frame at non-zero offset")

  ; ---------------------------------------------------------------------------
  ; Close and pong frame codec
  ; ---------------------------------------------------------------------------

  (assert-equal test
    8
    (let [f (WebSocket.encode-close)]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.opcode &frame)
        (Maybe.Nothing) -1))
    "decode close frame opcode")

  (assert-equal test
    10
    (let [f (WebSocket.encode-pong &(String.to-bytes &@"ping"))]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.opcode &frame)
        (Maybe.Nothing) -1))
    "decode pong frame opcode")

  ; ---------------------------------------------------------------------------
  ; web-routable-path
  ; ---------------------------------------------------------------------------

  (assert-equal test
    "/"
    &(let [req (Result.unsafe-from-success
             (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))]
      (web-routable-path &req))
    "routable-path for root")

  (assert-equal test
    "/users/42"
    &(let [req (Result.unsafe-from-success
             (Request.parse "GET /users/42 HTTP/1.1\r\nHost: x\r\n\r\n"))]
      (web-routable-path &req))
    "routable-path with segments")

  ; ---------------------------------------------------------------------------
  ; Keep-alive detection
  ; ---------------------------------------------------------------------------

  (assert-true test
    (let [req (Result.unsafe-from-success
            (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))]
      (web-keep-alive? &req))
    "HTTP/1.1 defaults to keep-alive")

  (assert-false test
    (let [req (Result.unsafe-from-success
            (Request.parse
              "GET / HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"))]
      (web-keep-alive? &req))
    "Connection: close disables keep-alive")

  ; ---------------------------------------------------------------------------
  ; Upgrade detection
  ; ---------------------------------------------------------------------------

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (Maybe.just? &(web-try-ws-upgrade &buf (App.ws-routes &app))))
    "upgrade detection matches WS route")

  (assert-true test
    (let [app (App.create)
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Key: abc\r\n\r\n")]
      (Maybe.nothing? &(web-try-ws-upgrade &buf (App.ws-routes &app))))
    "upgrade detection with no WS routes")

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes &@"GET / HTTP/1.1\r\nHost: x\r\n\r\n")]
      (Maybe.nothing? &(web-try-ws-upgrade &buf (App.ws-routes &app))))
    "non-upgrade request returns Nothing")

  ; ---------------------------------------------------------------------------
  ; Case-insensitive Upgrade header (RFC 7230 §3.2 / RFC 6455 §4.2.1)
  ; ---------------------------------------------------------------------------

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nupgrade: WebSocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (Maybe.just? &(web-try-ws-upgrade &buf (App.ws-routes &app))))
    "upgrade matches with lowercase header name and mixed-case value")

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUPGRADE: WEBSOCKET\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (Maybe.just? &(web-try-ws-upgrade &buf (App.ws-routes &app))))
    "upgrade matches with uppercase header name and value")

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nupgrade: websocket\r\nsec-websocket-version: 13\r\nsec-websocket-key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (Maybe.just? &(web-try-ws-upgrade &buf (App.ws-routes &app))))
    "upgrade matches with all-lowercase header names")

  ; ---------------------------------------------------------------------------
  ; App construction with WS routes
  ; ---------------------------------------------------------------------------

  (assert-equal test
    1
    (let [app (-> (App.create) (App.WS @"/ws/echo" (fn [event params ws] ())))]
      (Array.length (App.ws-routes &app)))
    "App.WS adds a WS route")

  (assert-equal test
    1
    (let [app (-> (App.create)
                  (App.GET @"/" (fn [r p] (Response.text @"")))
                  (App.WS @"/ws/echo" (fn [e p w] ())))]
      (Array.length (App.routes &app)))
    "WS routes do not affect HTTP routes count")

  ; ---------------------------------------------------------------------------
  ; Binary frame encoding (server-to-client, no mask)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    2
    (let [f (WebSocket.encode-binary &(the (Array Byte) []))] (Array.length &f))
    "encode-binary empty is 2 bytes (header only)")

  (assert-equal test
    (Byte.from-int 130)
    ; 0x82 = FIN + binary
    (let [f (WebSocket.encode-binary &[(Byte.from-int 1) (Byte.from-int 2)])]
      @(Array.unsafe-nth &f 0))
    "encode-binary sets FIN + opcode 2")

  (assert-equal test
    (Byte.from-int 3)
    (let [f (WebSocket.encode-binary
            &[(Byte.from-int 10) (Byte.from-int 20) (Byte.from-int 30)])]
      @(Array.unsafe-nth &f 1))
    "encode-binary sets payload length")

  (assert-equal test
    &[(Byte.from-int 222) (Byte.from-int 173)]
    &(let-do [f (WebSocket.encode-binary
                &[(Byte.from-int 222) (Byte.from-int 173)])
              payload (the (Array Byte) [])]
      (for [i 2 (Array.length &f)]
        (Array.push-back! &payload @(Array.unsafe-nth &f i)))
      @&payload)
    "encode-binary payload matches input")

  ; ---------------------------------------------------------------------------
  ; Binary frame decoding (client-to-server, masked)
  ; ---------------------------------------------------------------------------

  (assert-true test
    (let [data [(Byte.from-int 202) (Byte.from-int 254)]]
      (Maybe.just? &(WebSocket.decode-frame &(make-masked-binary-frame &data) 0)))
    "decode-frame succeeds on binary frame")

  (assert-equal test
    2
    (let [data [(Byte.from-int 202) (Byte.from-int 254)]]
      (match (WebSocket.decode-frame &(make-masked-binary-frame &data) 0)
        (Maybe.Just f) @(WSFrame.opcode &f)
        (Maybe.Nothing) -1))
    "decode-frame returns opcode 2 for binary")

  (assert-equal test
    &[(Byte.from-int 202) (Byte.from-int 254)]
    &(let [data [(Byte.from-int 202) (Byte.from-int 254)]]
      (match (WebSocket.decode-frame &(make-masked-binary-frame &data) 0)
        (Maybe.Just f) @(WSFrame.payload &f)
        (Maybe.Nothing) (the (Array Byte) [])))
    "decode-frame unmasks binary payload correctly")

  ; ---------------------------------------------------------------------------
  ; Binary encode/decode round-trip (server frame, no mask)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    &[(Byte.from-int 1) (Byte.from-int 2) (Byte.from-int 3)]
    &(let [data [(Byte.from-int 1) (Byte.from-int 2) (Byte.from-int 3)]
           encoded (WebSocket.encode-binary &data)]
      (match (WebSocket.decode-frame &encoded 0)
        (Maybe.Just f) @(WSFrame.payload &f)
        (Maybe.Nothing) (the (Array Byte) [])))
    "binary frame round-trips through decode")

  ; ---------------------------------------------------------------------------
  ; Binary extended length encoding (16-bit)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    (Byte.from-int 126)
    (let [f (WebSocket.encode-binary &(Array.replicate 200 &(Byte.from-int 255)))]
      @(Array.unsafe-nth &f 1))
    "encode-binary uses 16-bit length for >125 bytes")

  (assert-equal test
    200
    (let [f (WebSocket.encode-binary &(Array.replicate 200 &(Byte.from-int 255)))]
      (- (Array.length &f) 4))
    "encode-binary 16-bit payload length correct")

  ; ---------------------------------------------------------------------------
  ; 64-bit payload length encoding
  ; ---------------------------------------------------------------------------

  ; encode-text uses 64-bit length indicator for payloads >= 65536
  (assert-equal test
    (Byte.from-int 127)
    (let [f (WebSocket.encode-text &(String.allocate 65536 \x))]
      @(Array.unsafe-nth &f 1))
    "encode-text uses 64-bit length for >= 65536 bytes")

  ; 64-bit encode/decode round-trip
  (assert-equal test
    65536
    (let [f (WebSocket.encode-text &(String.allocate 65536 \x))]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) (Array.length (WSFrame.payload &frame))
        (Maybe.Nothing) -1))
    "64-bit frame round-trips with correct payload length")

  ; High 32 bits in 64-bit header are not truncated.
  ; Craft a raw frame header with byte 5 = 1 (plen high word = 2^32).
  ; The buffer is tiny, so decode must return Nothing.
  ; Old code ignored bytes 2-5 and would read plen=0, returning a
  ; zero-payload frame instead.
  (assert-true test
    (let [buf (the (Array Byte)
                   [(Byte.from-int 130)
                    ; FIN + binary, unmasked
                    (Byte.from-int 127)
                    ; 64-bit length indicator
                    (Byte.from-int 0)
                    (Byte.from-int 0)
                    (Byte.from-int 0)
                    (Byte.from-int 1)
                    ; bytes 2-5: plen = 1 * 2^32 = 4294967296
                    (Byte.from-int 0)
                    (Byte.from-int 0)
                    (Byte.from-int 0)
                    (Byte.from-int 0)])]
      ; bytes 6-9: low word = 0
      (Maybe.nothing? &(WebSocket.decode-frame &buf 0)))
    "64-bit length high bytes are not truncated")

  ; ---------------------------------------------------------------------------
  ; FIN bit extraction
  ; ---------------------------------------------------------------------------

  (assert-true test
    (match (WebSocket.decode-frame &(make-masked-text-frame "hi") 0)
      (Maybe.Just f) @(WSFrame.fin &f)
      (Maybe.Nothing) false)
    "decode-frame FIN=true on normal text frame")

  (assert-false test
    (let [frame (make-masked-frame false 1 &(String.to-bytes &@"hi"))]
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.fin &f)
        (Maybe.Nothing) true))
    "decode-frame FIN=false on non-final text frame")

  (assert-equal test
    1
    (let [frame (make-masked-frame false 1 &(String.to-bytes &@"hi"))]
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.opcode &f)
        (Maybe.Nothing) -1))
    "non-final text frame has opcode 1")

  ; ---------------------------------------------------------------------------
  ; Continuation frame codec
  ; ---------------------------------------------------------------------------

  (assert-equal test
    0
    (let [frame (make-masked-frame false 0 &(String.to-bytes &@"cont"))]
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.opcode &f)
        (Maybe.Nothing) -1))
    "continuation frame has opcode 0")

  (assert-false test
    (let [frame (make-masked-frame false 0 &(String.to-bytes &@"cont"))]
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.fin &f)
        (Maybe.Nothing) true))
    "non-final continuation has FIN=false")

  (assert-true test
    (let [frame (make-masked-frame true 0 &(String.to-bytes &@"end"))]
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.fin &f)
        (Maybe.Nothing) false))
    "final continuation has FIN=true")

  (assert-equal test
    "end"
    &(let [frame (make-masked-frame true 0 &(String.to-bytes &@"end"))]
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) (String.from-bytes (WSFrame.payload &f))
        (Maybe.Nothing) @"FAIL"))
    "final continuation payload decoded correctly")

  ; ---------------------------------------------------------------------------
  ; Fragmented frame sequence in a single buffer
  ; ---------------------------------------------------------------------------

  (assert-equal test
    3
    (let-do [f1 (make-masked-frame false 1 &(String.to-bytes &@"hel"))
             f2 (make-masked-frame false 0 &(String.to-bytes &@"lo"))
             f3 (make-masked-frame true 0 &(String.to-bytes &@"!"))
             buf (the (Array Byte) [])
             count 0]
      (for [i 0 (Array.length &f1)]
        (Array.push-back! &buf @(Array.unsafe-nth &f1 i)))
      (for [i 0 (Array.length &f2)]
        (Array.push-back! &buf @(Array.unsafe-nth &f2 i)))
      (for [i 0 (Array.length &f3)]
        (Array.push-back! &buf @(Array.unsafe-nth &f3 i)))
      (let-do [offset 0]
        (while (< offset (Array.length &buf))
          (match (WebSocket.decode-frame &buf offset)
            (Maybe.Nothing) (break)
            (Maybe.Just frame)
              (do
                (set! count (+ count 1))
                (set! offset (+ offset @(WSFrame.consumed &frame)))))))
      count)
    "three fragment frames decode from single buffer")

  (assert-equal test
    "hello!"
    &(let-do [f1 (make-masked-frame false 1 &(String.to-bytes &@"hel"))
              f2 (make-masked-frame false 0 &(String.to-bytes &@"lo"))
              f3 (make-masked-frame true 0 &(String.to-bytes &@"!"))
              buf (the (Array Byte) [])
              assembled (the (Array Byte) [])]
      (for [i 0 (Array.length &f1)]
        (Array.push-back! &buf @(Array.unsafe-nth &f1 i)))
      (for [i 0 (Array.length &f2)]
        (Array.push-back! &buf @(Array.unsafe-nth &f2 i)))
      (for [i 0 (Array.length &f3)]
        (Array.push-back! &buf @(Array.unsafe-nth &f3 i)))
      (let-do [offset 0]
        (while (< offset (Array.length &buf))
          (match (WebSocket.decode-frame &buf offset)
            (Maybe.Nothing) (break)
            (Maybe.Just frame)
              (do
                (for [k 0 (Array.length (WSFrame.payload &frame))]
                  (Array.push-back! &assembled
                                    @(Array.unsafe-nth (WSFrame.payload &frame)
                                                       k)))
                (set! offset (+ offset @(WSFrame.consumed &frame)))))))
      (String.from-bytes &assembled))
    "reassembled fragments produce correct message")

  ; ---------------------------------------------------------------------------
  ; Interleaved control frame in fragment sequence
  ; ---------------------------------------------------------------------------

  (assert-equal test
    4
    (let-do [f1 (make-masked-frame false 1 &(String.to-bytes &@"hel"))
             ping (make-masked-frame true 9 &(String.to-bytes &@""))
             f2 (make-masked-frame false 0 &(String.to-bytes &@"lo"))
             f3 (make-masked-frame true 0 &(String.to-bytes &@"!"))
             buf (the (Array Byte) [])
             count 0]
      (for [i 0 (Array.length &f1)]
        (Array.push-back! &buf @(Array.unsafe-nth &f1 i)))
      (for [i 0 (Array.length &ping)]
        (Array.push-back! &buf @(Array.unsafe-nth &ping i)))
      (for [i 0 (Array.length &f2)]
        (Array.push-back! &buf @(Array.unsafe-nth &f2 i)))
      (for [i 0 (Array.length &f3)]
        (Array.push-back! &buf @(Array.unsafe-nth &f3 i)))
      (let-do [offset 0]
        (while (< offset (Array.length &buf))
          (match (WebSocket.decode-frame &buf offset)
            (Maybe.Nothing) (break)
            (Maybe.Just frame)
              (do
                (set! count (+ count 1))
                (set! offset (+ offset @(WSFrame.consumed &frame)))))))
      count)
    "interleaved ping parses as separate frame in fragment sequence")

  (assert-equal test
    9
    (let-do [f1 (make-masked-frame false 1 &(String.to-bytes &@"hel"))
             ping (make-masked-frame true 9 &(String.to-bytes &@""))
             buf (the (Array Byte) [])]
      (for [i 0 (Array.length &f1)]
        (Array.push-back! &buf @(Array.unsafe-nth &f1 i)))
      (for [i 0 (Array.length &ping)]
        (Array.push-back! &buf @(Array.unsafe-nth &ping i)))
      (let [off (Array.length &f1)]
        (match (WebSocket.decode-frame &buf off)
          (Maybe.Just f) @(WSFrame.opcode &f)
          (Maybe.Nothing) -1)))
    "ping after first fragment has correct opcode")

  ; ---------------------------------------------------------------------------
  ; RSV bits extraction (RFC 6455 §5.2)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    0
    (match (WebSocket.decode-frame &(make-masked-text-frame "hi") 0)
      (Maybe.Just f) @(WSFrame.rsv &f)
      (Maybe.Nothing) -1)
    "normal frame has RSV=0")

  (assert-equal test
    4
    ; RSV1 set: byte 0 = 0xC1 (FIN=1, RSV1=1, opcode=1)
    (let-do [frame (the (Array Byte) [])
             mask [(Byte.from-int 55)
                   (Byte.from-int 250)
                   (Byte.from-int 33)
                   (Byte.from-int 61)]]
      (Array.push-back! &frame (Byte.from-int 193))
      (Array.push-back! &frame (Byte.from-int (+ 128 2)))
      (for [i 0 4] (Array.push-back! &frame @(Array.unsafe-nth &mask i)))
      (Array.push-back! &frame (Byte.from-int (bit-xor (Char.to-int \h) 55)))
      (Array.push-back! &frame (Byte.from-int (bit-xor (Char.to-int \i) 250)))
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.rsv &f)
        (Maybe.Nothing) -1))
    "frame with RSV1 set reports RSV=4")

  (assert-equal test
    7
    ; All RSV bits set: byte 0 = 0xF1 (FIN=1, RSV1=1, RSV2=1, RSV3=1, opcode=1)
    (let-do [frame (the (Array Byte) [])
             mask [(Byte.from-int 55)
                   (Byte.from-int 250)
                   (Byte.from-int 33)
                   (Byte.from-int 61)]]
      (Array.push-back! &frame (Byte.from-int 241))
      (Array.push-back! &frame (Byte.from-int (+ 128 0)))
      (for [i 0 4] (Array.push-back! &frame @(Array.unsafe-nth &mask i)))
      (match (WebSocket.decode-frame &frame 0)
        (Maybe.Just f) @(WSFrame.rsv &f)
        (Maybe.Nothing) -1))
    "frame with all RSV bits set reports RSV=7")

  ; ---------------------------------------------------------------------------
  ; Masked flag extraction (RFC 6455 §5.1)
  ; ---------------------------------------------------------------------------

  (assert-true test
    (match (WebSocket.decode-frame &(make-masked-text-frame "hi") 0)
      (Maybe.Just f) @(WSFrame.masked &f)
      (Maybe.Nothing) false)
    "masked client frame has masked=true")

  (assert-false test
    (let [encoded (WebSocket.encode-text "hi")]
      (match (WebSocket.decode-frame &encoded 0)
        (Maybe.Just fr) @(WSFrame.masked &fr)
        (Maybe.Nothing) true))
    "unmasked server frame has masked=false")

  ; ---------------------------------------------------------------------------
  ; Close frame with status code encoding
  ; ---------------------------------------------------------------------------

  (assert-equal test
    8
    (let [f (WebSocket.encode-close-with-code 1002)]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.opcode &frame)
        (Maybe.Nothing) -1))
    "close-with-code has opcode 8")

  (assert-equal test
    2
    (let [f (WebSocket.encode-close-with-code 1002)]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) (Array.length (WSFrame.payload &frame))
        (Maybe.Nothing) -1))
    "close-with-code has 2-byte payload")

  (assert-equal test
    &[(Byte.from-int 3) (Byte.from-int 234)]
    ; 1002 = 0x03EA
    &(let [f (WebSocket.encode-close-with-code 1002)]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.payload &frame)
        (Maybe.Nothing) (the (Array Byte) [])))
    "close-with-code 1002 encodes correct status bytes")

  (assert-equal test
    &[(Byte.from-int 3) (Byte.from-int 241)]
    ; 1009 = 0x03F1
    &(let [f (WebSocket.encode-close-with-code 1009)]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.payload &frame)
        (Maybe.Nothing) (the (Array Byte) [])))
    "close-with-code 1009 encodes correct status bytes")

  ; ---------------------------------------------------------------------------
  ; Sec-WebSocket-Version validation (RFC 6455 §4.2.1)
  ; ---------------------------------------------------------------------------

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info) (>= @(Pair.a (Pair.b &info)) 0)
        (Maybe.Nothing) false))
    "upgrade with version 13 returns valid route index")

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 8\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info) (< @(Pair.a (Pair.b &info)) 0)
        (Maybe.Nothing) false))
    "upgrade with wrong version returns sentinel (ri < 0)")

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info) (< @(Pair.a (Pair.b &info)) 0)
        (Maybe.Nothing) false))
    "upgrade with missing version returns sentinel (ri < 0)")

  ; ---------------------------------------------------------------------------
  ; Ping frame encoding
  ; ---------------------------------------------------------------------------

  (assert-equal test
    9
    (let [f (WebSocket.encode-ping &(the (Array Byte) []))]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.opcode &frame)
        (Maybe.Nothing) -1))
    "encode-ping empty has opcode 9")

  (assert-equal test
    0
    (let [f (WebSocket.encode-ping &(the (Array Byte) []))]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) (Array.length (WSFrame.payload &frame))
        (Maybe.Nothing) -1))
    "encode-ping empty has 0-byte payload")

  (assert-equal test
    (Byte.from-int 137)
    ; 0x89 = FIN + ping
    (let [f (WebSocket.encode-ping &(the (Array Byte) []))]
      @(Array.unsafe-nth &f 0))
    "encode-ping sets FIN + opcode 9")

  (assert-equal test
    &[(Byte.from-int 1) (Byte.from-int 2) (Byte.from-int 3)]
    &(let [data [(Byte.from-int 1) (Byte.from-int 2) (Byte.from-int 3)]
           f (WebSocket.encode-ping &data)]
      (match (WebSocket.decode-frame &f 0)
        (Maybe.Just frame) @(WSFrame.payload &frame)
        (Maybe.Nothing) (the (Array Byte) [])))
    "encode-ping with payload round-trips through decode")

  (assert-equal test
    2
    (let [f (WebSocket.encode-ping &(the (Array Byte) []))] (Array.length &f))
    "encode-ping empty is 2 bytes (header only)")

  ; ---------------------------------------------------------------------------
  ; Ping/pong symmetry: ping and pong with same payload
  ; ---------------------------------------------------------------------------

  (assert-equal test
    true
    (let [payload [(Byte.from-int 42)]
          ping (WebSocket.encode-ping &payload)
          pong (WebSocket.encode-pong &payload)
          ping-pl (match (WebSocket.decode-frame &ping 0)
            (Maybe.Just f) @(WSFrame.payload &f)
            (Maybe.Nothing) (the (Array Byte) []))
          pong-pl (match (WebSocket.decode-frame &pong 0)
            (Maybe.Just f) @(WSFrame.payload &f)
            (Maybe.Nothing) (the (Array Byte) []))]
      (= &ping-pl &pong-pl))
    "ping and pong with same payload have identical payloads")

  ; ---------------------------------------------------------------------------
  ; WebSocket ping state machine (App.ws-ping-action)
  ; Returns: 0 = nothing, 1 = send ping, 2 = close as dead
  ; Params: ping-interval max-missed idle pcount since-ping write-pending
  ; ---------------------------------------------------------------------------

  ; -- Disabled pinging (interval <= 0) --

  (assert-equal test
    0
    (App.ws-ping-action 0 3 100 0 0 false)
    "ws-ping-action: interval=0 disables pinging")

  (assert-equal test
    0
    (App.ws-ping-action -5 3 100 0 0 false)
    "ws-ping-action: negative interval disables pinging")

  ; -- Not yet idle enough --

  (assert-equal test
    0
    (App.ws-ping-action 30 3 10 0 0 false)
    "ws-ping-action: idle < interval — nothing")

  (assert-equal test
    0
    (App.ws-ping-action 30 3 29 0 0 false)
    "ws-ping-action: idle just under interval — nothing")

  ; -- First ping --

  (assert-equal test
    1
    (App.ws-ping-action 30 3 30 0 0 false)
    "ws-ping-action: first ping at exactly interval")

  (assert-equal test
    1
    (App.ws-ping-action 30 3 45 0 0 false)
    "ws-ping-action: first ping well past interval")

  ; -- Subsequent pings --

  (assert-equal test
    1
    (App.ws-ping-action 30 3 65 1 35 false)
    "ws-ping-action: second ping when since-ping >= interval")

  (assert-equal test
    0
    (App.ws-ping-action 30 3 65 1 10 false)
    "ws-ping-action: too soon since last ping — nothing")

  ; -- Dead client detection --

  (assert-equal test
    2
    (App.ws-ping-action 30 3 120 3 35 false)
    "ws-ping-action: close after max missed pongs")

  (assert-equal test
    2
    (App.ws-ping-action 30 3 200 5 35 false)
    "ws-ping-action: close even with pcount > max")

  ; -- Write-pending guard --

  (assert-equal test
    0
    (App.ws-ping-action 30 3 35 0 0 true)
    "ws-ping-action: skip first ping when write pending")

  (assert-equal test
    0
    (App.ws-ping-action 30 3 65 1 35 true)
    "ws-ping-action: skip subsequent ping when write pending")

  (assert-equal test
    2
    (App.ws-ping-action 30 3 120 3 35 true)
    "ws-ping-action: close dead client even with write pending")

  ; -- Full lifecycle: fresh → ping → ping → ping → dead --

  (assert-equal test
    1
    (App.ws-ping-action 30 3 30 0 0 false)
    "lifecycle step 1: first ping (idle=30, pcount=0)")

  (assert-equal test
    1
    (App.ws-ping-action 30 3 60 1 30 false)
    "lifecycle step 2: second ping (idle=60, pcount=1, since-ping=30)")

  (assert-equal test
    1
    (App.ws-ping-action 30 3 90 2 30 false)
    "lifecycle step 3: third ping (idle=90, pcount=2, since-ping=30)")

  (assert-equal test
    2
    (App.ws-ping-action 30 3 120 3 30 false)
    "lifecycle step 4: dead (idle=120, pcount=3)")

  ; -- Pong resets the cycle --

  (assert-equal test
    1
    (App.ws-ping-action 30 3 60 0 0 false)
    "after pong resets pcount to 0: resumes pinging")

  ; ---------------------------------------------------------------------------
  ; ws-parse-protocols (Sec-WebSocket-Protocol header parsing)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    &[@"chat" @"superchat"]
    &(ws-parse-protocols "chat, superchat")
    "parse-protocols splits comma-separated values")

  (assert-equal test
    &[@"chat" @"superchat"]
    &(ws-parse-protocols "chat,superchat")
    "parse-protocols handles no spaces")

  (assert-equal test
    &[@"chat"]
    &(ws-parse-protocols "chat")
    "parse-protocols single value")

  (assert-equal test
    &(the (Array String) [])
    &(ws-parse-protocols "")
    "parse-protocols empty string")

  (assert-equal test
    &[@"rpc" @"chat-v2"]
    &(ws-parse-protocols "  rpc , chat-v2  ")
    "parse-protocols trims whitespace")

  ; ---------------------------------------------------------------------------
  ; ws-negotiate-protocol (subprotocol selection)
  ; ---------------------------------------------------------------------------

  (assert-equal test
    &(Maybe.Just @"chat")
    &(ws-negotiate-protocol &[@"chat" @"rpc"] &[@"rpc" @"chat"])
    "negotiate selects first client protocol found in server list")

  (assert-equal test
    &(Maybe.Just @"rpc")
    &(ws-negotiate-protocol &[@"rpc" @"chat"] &[@"rpc" @"chat"])
    "negotiate respects client preference order")

  (assert-equal test
    &(the (Maybe String) (Maybe.Nothing))
    &(ws-negotiate-protocol &[@"foo"] &[@"bar" @"baz"])
    "negotiate returns Nothing when no match")

  (assert-equal test
    &(the (Maybe String) (Maybe.Nothing))
    &(ws-negotiate-protocol &(the (Array String) []) &[@"chat"])
    "negotiate returns Nothing when client list empty")

  (assert-equal test
    &(the (Maybe String) (Maybe.Nothing))
    &(ws-negotiate-protocol &[@"chat"] &(the (Array String) []))
    "negotiate returns Nothing when server list empty")

  ; ---------------------------------------------------------------------------
  ; Subprotocol negotiation through upgrade path
  ; ---------------------------------------------------------------------------

  (assert-true test
    (let [app (App.WSP (App.create)
                       @"/ws"
                       [@"chat-v2" @"chat-v1"]
                       (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: chat-v1, chat-v2\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info)
          (= &(Maybe.Just @"chat-v1") (Pair.a (Pair.b (Pair.b &info))))
        (Maybe.Nothing) false))
    "upgrade negotiates first matching client protocol")

  (assert-true test
    (let [app (App.WSP (App.create)
                       @"/ws"
                       [@"chat-v2" @"chat-v1"]
                       (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: chat-v2\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info)
          (= &(Maybe.Just @"chat-v2") (Pair.a (Pair.b (Pair.b &info))))
        (Maybe.Nothing) false))
    "upgrade negotiates single matching protocol")

  (assert-true test
    (let [app (App.WSP (App.create)
                       @"/ws"
                       [@"chat-v2" @"chat-v1"]
                       (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: unknown-proto\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info) (Maybe.nothing? (Pair.a (Pair.b (Pair.b &info))))
        (Maybe.Nothing) false))
    "upgrade with no matching protocol returns Nothing protocol")

  (assert-true test
    (let [app (App.WSP (App.create)
                       @"/ws"
                       [@"chat-v2" @"chat-v1"]
                       (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info) (Maybe.nothing? (Pair.a (Pair.b (Pair.b &info))))
        (Maybe.Nothing) false))
    "upgrade without Sec-WebSocket-Protocol header returns Nothing protocol")

  (assert-true test
    (let [app (App.WS (App.create) @"/ws" (fn [e p w] ()))
          buf (String.to-bytes
            &@"GET /ws HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: chat\r\n\r\n")]
      (match (web-try-ws-upgrade &buf (App.ws-routes &app))
        (Maybe.Just info) (Maybe.nothing? (Pair.a (Pair.b (Pair.b &info))))
        (Maybe.Nothing) false))
    "WS route (no protocols) ignores client Sec-WebSocket-Protocol")

  ; ---------------------------------------------------------------------------
  ; App.WSP route construction
  ; ---------------------------------------------------------------------------

  (assert-equal test
    1
    (let [app (-> (App.create) (App.WSP @"/ws/chat" [@"chat"] (fn [e p w] ())))]
      (Array.length (App.ws-routes &app)))
    "App.WSP adds a WS route")

  (assert-equal test
    &[@"chat-v2" @"chat-v1"]
    &(let [app (-> (App.create)
                   (App.WSP @"/ws/chat" [@"chat-v2" @"chat-v1"] (fn [e p w] ())))]
      @(WSRoute.protocols (Array.unsafe-first (App.ws-routes &app))))
    "App.WSP stores protocols on the route")

  (assert-equal test
    &(the (Array String) [])
    &(let [app (-> (App.create) (App.WS @"/ws/echo" (fn [e p w] ())))]
      @(WSRoute.protocols (Array.unsafe-first (App.ws-routes &app))))
    "App.WS stores empty protocols on the route")

  ; ---------------------------------------------------------------------------
  ; Fragment TTL and size limit defaults
  ; ---------------------------------------------------------------------------

  (assert-equal test 30 App.ws-frag-ttl "ws-frag-ttl defaults to 30 seconds")

  (assert-equal test
    1048576
    App.ws-max-frag-size
    "ws-max-frag-size defaults to 1 MiB"))
