(load "Test.carp")
(load "../web.carp")
(use Test)

; ---------------------------------------------------------------------------
; Response helper tests
; ---------------------------------------------------------------------------

(deftest test
  ; -- Response.text --
  (assert-equal test
    200
    @(Response.code &(Response.text @"hi"))
    "text returns 200")

  (assert-equal test
    "hi"
    (Response.body &(Response.text @"hi"))
    "text sets body")

  ; -- Response.html --
  (assert-equal test
    200
    @(Response.code &(Response.html @"<h1>hi</h1>"))
    "html returns 200")

  ; -- Response.json --
  (assert-equal test
    200
    @(Response.code &(Response.json &(JSON.Null)))
    "json returns 200")
  (assert-equal test
    "null"
    (Response.body &(Response.json &(JSON.Null)))
    "json serializes body")

  ; -- Response.not-found --
  (assert-equal test
    404
    @(Response.code &(Response.not-found))
    "not-found returns 404")

  ; -- Response.bad-request --
  (assert-equal test
    400
    @(Response.code &(Response.bad-request))
    "bad-request returns 400")

  ; -- Response.redirect --
  (assert-equal test
    302
    @(Response.code &(Response.redirect @"/other"))
    "redirect returns 302")

  ; -- Response.with-header --
  (assert-equal test
    200
    @(Response.code
      &(Response.with-header (Response.text @"hi") @"X-Custom" @"val"))
    "with-header preserves status")

  ; -- Response.with-status --
  (assert-equal test
    201
    @(Response.code
      &(Response.with-status (Response.text @"created") 201 @"Created"))
    "with-status sets code")

  ; ---------------------------------------------------------------------------
  ; Route matching tests
  ; ---------------------------------------------------------------------------

  ; -- exact match --
  (assert-true test
    (Maybe.just? &(match-route "/hello" "/hello"))
    "exact path matches")

  (assert-true test
    (Maybe.nothing? &(match-route "/hello" "/world"))
    "different path does not match")

  (assert-true test
    (Maybe.nothing? &(match-route "/a/b" "/a"))
    "different length does not match")

  ; -- param capture --
  (assert-true test
    (Maybe.just? &(match-route "/users/:id" "/users/42"))
    "param route matches")

  (assert-equal test
    "42"
    &(Map.get
      &(match (match-route "/users/:id" "/users/42")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "id")
    "param route captures id")

  ; -- multiple params --
  (assert-equal test
    "posts"
    &(Map.get
      &(match (match-route "/users/:uid/:resource" "/users/1/posts")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "resource")
    "multi-param captures second param")

  ; -- root path --
  (assert-true test (Maybe.just? &(match-route "/" "/")) "root path matches")

  ; -- wildcard pattern --
  (assert-true test
    (Maybe.just? &(match-route "*" "/anything/at/all"))
    "wildcard pattern matches multi-segment path")

  (assert-true test
    (Maybe.just? &(match-route "*" "/"))
    "wildcard pattern matches root")

  ; -- content-type detection --
  (assert-equal test
    "text/html; charset=utf-8"
    &(Response.content-type-for "index.html")
    "content-type-for html")

  (assert-equal test
    "application/javascript; charset=utf-8"
    &(Response.content-type-for "/assets/index.js")
    "content-type-for js")

  (assert-equal test
    "application/octet-stream"
    &(Response.content-type-for "blob.unknown")
    "content-type-for unknown extension")

  ; -- safe-path? --
  (assert-true test
    (web-safe-path? "foo/bar/baz.txt")
    "safe-path? accepts a normal path")

  (assert-false test
    (web-safe-path? "foo/../etc/passwd")
    "safe-path? rejects ..")

  ; -- before-hook short-circuit --
  (assert-true test
    (let [params (the (Map String String) {})]
      (Maybe.just?
        &(web-run-before
          &[(fn [req p] (Maybe.Just (Response.text @"blocked")))]
          &(Result.unsafe-from-success
            (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
          &params)))
    "before-hook can short-circuit")

  ; -- before-hook annotates params --
  (assert-true test
    (let-do [params (the (Map String String) {})
             req (Result.unsafe-from-success
               (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))]
      (ignore
        (web-run-before
          &[(fn [r p] (do (Map.put! p &@"_tagged" &@"yes") (Maybe.Nothing)))]
          &req
          &params))
      (Map.contains? &params "_tagged"))
    "before-hook can annotate params")

  ; -- after-hook modifies response --
  (assert-equal test
    201
    (let-do [params (the (Map String String) {})
             req (Result.unsafe-from-success
               (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
             resp (web-run-after
               &[(fn [r p resp] (Response.with-status resp 201 @"Created"))]
               &req
               &params
               (Response.text @"ok"))]
      @(Response.code &resp))
    "after-hook can modify status code")

  ; ---------------------------------------------------------------------------
  ; App construction tests
  ; ---------------------------------------------------------------------------

  ; -- prefix glob route --
  (assert-true test
    (Maybe.just? &(match-route "/api/*" "/api/foo/bar"))
    "prefix glob matches multi-segment tail")

  (assert-equal test
    "foo/bar"
    &(Map.get
      &(match (match-route "/api/*" "/api/foo/bar")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "*")
    "prefix glob captures tail as *")

  (assert-true test
    (Maybe.nothing? &(match-route "/api/*" "/other/foo"))
    "prefix glob rejects non-matching prefix")

  (assert-true test
    (Maybe.just? &(match-route "/users/:id/*" "/users/42/posts"))
    "prefix glob with named captures matches")

  (assert-equal test
    "42"
    &(Map.get
      &(match (match-route "/users/:id/*" "/users/42/posts/1")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "id")
    "prefix glob preserves named captures")

  ; -- form parsing --
  (assert-equal test
    "bar"
    &(Map.get &(Form.decode "foo=bar&baz=qux") "foo")
    "Form.decode extracts key")

  (assert-equal test
    "hello world"
    &(Map.get &(Form.decode "msg=hello+world") "msg")
    "Form.decode does not decode + as space")

  (assert-equal test
    "hello world"
    &(Map.get &(Form.decode "msg=hello%20world") "msg")
    "Form.decode decodes percent-encoding")

  (assert-equal test
    ""
    &(Map.get &(Form.decode "flag&other=1") "flag")
    "Form.decode handles key without value")

  (assert-equal test
    3
    (let [app (-> (App.create)
                  (App.GET @"/a" (fn [r p] (Response.text @"")))
                  (App.POST @"/b" (fn [r p] (Response.text @"")))
                  (App.DELETE @"/c" (fn [r p] (Response.text @""))))]
      (Array.length (App.routes &app)))
    "app accumulates routes")

  ; ---------------------------------------------------------------------------
  ; Multipart form-data parsing tests
  ; ---------------------------------------------------------------------------

  ; -- decode-multipart: single text field --
  (assert-equal test
    1
    (Array.length
      &(Form.decode-multipart
        "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
        "abc"))
    "decode-multipart parses single part")

  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts name")

  (assert-equal test
    "value1"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts body")

  ; -- decode-multipart: multiple parts --
  (assert-equal test
    2
    (Array.length
      &(Form.decode-multipart
        "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
        "abc"))
    "decode-multipart parses two parts")

  (assert-equal test
    "val-b"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
          "abc")
        1))
    "decode-multipart extracts second part body")

  ; -- decode-multipart: file upload with filename and content-type --
  (assert-true test
    (Maybe.just?
      (FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart detects filename")

  (assert-equal test
    "test.txt"
    &(Maybe.unsafe-from
      @(FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart extracts filename value")

  (assert-equal test
    "text/plain"
    (FormPart.content-type
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts content-type")

  ; -- decode-multipart: default content-type --
  (assert-equal test
    "text/plain"
    (FormPart.content-type
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n--abc--"
          "abc")
        0))
    "decode-multipart defaults content-type to text/plain")

  ; -- decode-multipart: no filename for text field --
  (assert-true test
    (Maybe.nothing?
      (FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n--abc--"
            "abc")
          0)))
    "decode-multipart has no filename for text field")

  ; -- decode-multipart: empty body --
  (assert-equal test
    0
    (Array.length &(Form.decode-multipart "" "abc"))
    "decode-multipart returns empty for empty body")

  ; -- decode-multipart: case-insensitive headers --
  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\ncontent-disposition: form-data; name=\"field1\"\r\n\r\nval\r\n--abc--"
          "abc")
        0))
    "decode-multipart handles lowercase headers")

  ; -- decode-multipart: case-insensitive param names --
  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; Name=\"field1\"\r\n\r\nval\r\n--abc--"
          "abc")
        0))
    "decode-multipart handles uppercase param Name")

  (assert-equal test
    "test.txt"
    &(Maybe.unsafe-from
      @(FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"f\"; Filename=\"test.txt\"\r\n\r\ndata\r\n--abc--"
            "abc")
          0)))
    "decode-multipart handles uppercase Filename param")

  ; -- decode-multipart: transport padding on boundary --
  (assert-equal test
    1
    (Array.length
      &(Form.decode-multipart
        "--abc  \r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nval\r\n--abc--"
        "abc"))
    "decode-multipart tolerates padding after initial boundary")

  (assert-equal test
    2
    (Array.length
      &(Form.decode-multipart
        "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc \t\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
        "abc"))
    "decode-multipart tolerates padding between parts")

  ; -- decode-multipart-request: case-insensitive boundary param --
  (assert-equal test
    "hello"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart-request
          &(Result.unsafe-from-success
            (Request.parse
              "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; Boundary=xyz\r\n\r\n--xyz\r\nContent-Disposition: form-data; name=\"msg\"\r\n\r\nhello\r\n--xyz--")))
        0))
    "decode-multipart-request handles uppercase Boundary param")

  ; -- multipart? --
  (assert-true test
    (Form.multipart?
      &(Result.unsafe-from-success
        (Request.parse
          "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; boundary=abc\r\n\r\n")))
    "multipart? detects multipart content type")

  (assert-false test
    (Form.multipart?
      &(Result.unsafe-from-success
        (Request.parse
          "POST / HTTP/1.1\r\nContent-Type: application/json\r\n\r\n")))
    "multipart? false for non-multipart")

  (assert-false test
    (Form.multipart?
      &(Result.unsafe-from-success
        (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n")))
    "multipart? false when no content-type")

  ; -- decode-multipart-request --
  (assert-equal test
    "hello"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart-request
          &(Result.unsafe-from-success
            (Request.parse
              "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; boundary=xyz\r\n\r\n--xyz\r\nContent-Disposition: form-data; name=\"msg\"\r\n\r\nhello\r\n--xyz--")))
        0))
    "decode-multipart-request parses from request")

  (assert-equal test
    0
    (Array.length
      &(Form.decode-multipart-request
        &(Result.unsafe-from-success
          (Request.parse
            "POST / HTTP/1.1\r\nContent-Type: application/json\r\n\r\n{}"))))
    "decode-multipart-request empty for non-multipart")

  ; ---------------------------------------------------------------------------
  ; Response finalization tests
  ; ---------------------------------------------------------------------------

  ; -- finalize omits Content-Length for chunked responses --
  (assert-false test
    (Map.contains?
      (Response.headers
        &(web-finalize-response
          (Response.chunked 200 @"text/plain" &[@"hello"])
          true))
      "Content-Length")
    "finalize omits Content-Length when Transfer-Encoding is set")

  ; -- finalize adds Content-Length for normal responses --
  (assert-true test
    (Map.contains?
      (Response.headers &(web-finalize-response (Response.text @"hi") true))
      "Content-Length")
    "finalize adds Content-Length for normal responses")

  ; ---------------------------------------------------------------------------
  ; log-after safety tests
  ; ---------------------------------------------------------------------------

  ; -- log-after does not crash when _start is missing --
  (assert-equal test
    200
    (let [req (Result.unsafe-from-success
            (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
          params (the (Map String String) {})]
      @(Response.code &(log-after &req &params (Response.text @"ok"))))
    "log-after does not crash without _start param"))
