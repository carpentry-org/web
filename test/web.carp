(load "Test.carp")
(load "../web.carp")
(use Test)

(defn parse-req [s]
  (match (Request.parse s)
    (Result.Success r) r
    (Result.Error _) (Request.init @"GET" @"HTTP/1.1" (zero) [] {} @"")))

; ---------------------------------------------------------------------------
; Response helper tests
; ---------------------------------------------------------------------------

(deftest test
  ; -- Response.text --
  (assert-equal test
    200
    @(Response.code &(Response.text @"hi"))
    "text returns 200")

  (assert-equal test
    "hi"
    (Response.body &(Response.text @"hi"))
    "text sets body")

  ; -- Response.html --
  (assert-equal test
    200
    @(Response.code &(Response.html @"<h1>hi</h1>"))
    "html returns 200")

  ; -- Response.json --
  (assert-equal test
    200
    @(Response.code &(Response.json &(JSON.Null)))
    "json returns 200")
  (assert-equal test
    "null"
    (Response.body &(Response.json &(JSON.Null)))
    "json serializes body")

  ; -- Response.not-found --
  (assert-equal test
    404
    @(Response.code &(Response.not-found))
    "not-found returns 404")

  ; -- Response.bad-request --
  (assert-equal test
    400
    @(Response.code &(Response.bad-request))
    "bad-request returns 400")

  ; -- Response.redirect --
  (assert-equal test
    302
    @(Response.code &(Response.redirect @"/other"))
    "redirect returns 302")

  ; -- Response.with-header --
  (assert-equal test
    200
    @(Response.code
      &(Response.with-header (Response.text @"hi") @"X-Custom" @"val"))
    "with-header preserves status")

  ; -- Response.with-status --
  (assert-equal test
    201
    @(Response.code
      &(Response.with-status (Response.text @"created") 201 @"Created"))
    "with-status sets code")

  ; ---------------------------------------------------------------------------
  ; Route matching tests
  ; ---------------------------------------------------------------------------

  ; -- exact match --
  (assert-true test
    (Maybe.just? &(match-route "/hello" "/hello"))
    "exact path matches")

  (assert-true test
    (Maybe.nothing? &(match-route "/hello" "/world"))
    "different path does not match")

  (assert-true test
    (Maybe.nothing? &(match-route "/a/b" "/a"))
    "different length does not match")

  ; -- param capture --
  (assert-true test
    (Maybe.just? &(match-route "/users/:id" "/users/42"))
    "param route matches")

  (assert-equal test
    "42"
    &(Map.get
      &(match (match-route "/users/:id" "/users/42")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "id")
    "param route captures id")

  ; -- multiple params --
  (assert-equal test
    "posts"
    &(Map.get
      &(match (match-route "/users/:uid/:resource" "/users/1/posts")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "resource")
    "multi-param captures second param")

  ; -- root path --
  (assert-true test (Maybe.just? &(match-route "/" "/")) "root path matches")

  ; -- wildcard pattern --
  (assert-true test
    (Maybe.just? &(match-route "*" "/anything/at/all"))
    "wildcard pattern matches multi-segment path")

  (assert-true test
    (Maybe.just? &(match-route "*" "/"))
    "wildcard pattern matches root")

  ; -- content-type detection --
  (assert-equal test
    "text/html; charset=utf-8"
    &(Response.content-type-for "index.html")
    "content-type-for html")

  (assert-equal test
    "application/javascript; charset=utf-8"
    &(Response.content-type-for "/assets/index.js")
    "content-type-for js")

  (assert-equal test
    "application/octet-stream"
    &(Response.content-type-for "blob.unknown")
    "content-type-for unknown extension")

  ; -- safe-path? --
  (assert-true test
    (web-safe-path? "foo/bar/baz.txt")
    "safe-path? accepts a normal path")

  (assert-false test
    (web-safe-path? "foo/../etc/passwd")
    "safe-path? rejects ..")

  ; -- before-hook short-circuit --
  (assert-true test
    (let [params (the (Map String String) {})]
      (Maybe.just?
        &(web-run-before
          &[(fn [req p] (Maybe.Just (Response.text @"blocked")))]
          &(parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          &params)))
    "before-hook can short-circuit")

  ; -- before-hook annotates params --
  (assert-true test
    (let-do [params (the (Map String String) {})
             req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")]
      (ignore
        (web-run-before
          &[(fn [r p] (do (Map.put! p &@"_tagged" &@"yes") (Maybe.Nothing)))]
          &req
          &params))
      (Map.contains? &params "_tagged"))
    "before-hook can annotate params")

  ; -- after-hook modifies response --
  (assert-equal test
    201
    (let-do [params (the (Map String String) {})
             req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
             resp (web-run-after
               &[(fn [r p resp] (Response.with-status resp 201 @"Created"))]
               &req
               &params
               (Response.text @"ok"))]
      @(Response.code &resp))
    "after-hook can modify status code")

  ; ---------------------------------------------------------------------------
  ; App construction tests
  ; ---------------------------------------------------------------------------

  ; -- prefix glob route --
  (assert-true test
    (Maybe.just? &(match-route "/api/*" "/api/foo/bar"))
    "prefix glob matches multi-segment tail")

  (assert-equal test
    "foo/bar"
    &(Map.get
      &(match (match-route "/api/*" "/api/foo/bar")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "*")
    "prefix glob captures tail as *")

  (assert-true test
    (Maybe.nothing? &(match-route "/api/*" "/other/foo"))
    "prefix glob rejects non-matching prefix")

  (assert-true test
    (Maybe.just? &(match-route "/users/:id/*" "/users/42/posts"))
    "prefix glob with named captures matches")

  (assert-equal test
    "42"
    &(Map.get
      &(match (match-route "/users/:id/*" "/users/42/posts/1")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "id")
    "prefix glob preserves named captures")

  ; -- form parsing --
  (assert-equal test
    "bar"
    &(Map.get &(Form.decode "foo=bar&baz=qux") "foo")
    "Form.decode extracts key")

  (assert-equal test
    "hello world"
    &(Map.get &(Form.decode "msg=hello+world") "msg")
    "Form.decode does not decode + as space")

  (assert-equal test
    "hello world"
    &(Map.get &(Form.decode "msg=hello%20world") "msg")
    "Form.decode decodes percent-encoding")

  (assert-equal test
    ""
    &(Map.get &(Form.decode "flag&other=1") "flag")
    "Form.decode handles key without value")

  (assert-equal test
    3
    (let [app (-> (App.create)
                  (App.GET @"/a" (fn [r p] (Response.text @"")))
                  (App.POST @"/b" (fn [r p] (Response.text @"")))
                  (App.DELETE @"/c" (fn [r p] (Response.text @""))))]
      (Array.length (App.routes &app)))
    "app accumulates routes")

  ; ---------------------------------------------------------------------------
  ; Multipart form-data parsing tests
  ; ---------------------------------------------------------------------------

  ; -- decode-multipart: single text field --
  (assert-equal test
    1
    (Array.length
      &(Form.decode-multipart
        "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
        "abc"))
    "decode-multipart parses single part")

  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts name")

  (assert-equal test
    "value1"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts body")

  ; -- decode-multipart: multiple parts --
  (assert-equal test
    2
    (Array.length
      &(Form.decode-multipart
        "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
        "abc"))
    "decode-multipart parses two parts")

  (assert-equal test
    "val-b"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
          "abc")
        1))
    "decode-multipart extracts second part body")

  ; -- decode-multipart: file upload with filename and content-type --
  (assert-true test
    (Maybe.just?
      (FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart detects filename")

  (assert-equal test
    "test.txt"
    &(Maybe.unsafe-from
      @(FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart extracts filename value")

  (assert-equal test
    "text/plain"
    (FormPart.content-type
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts content-type")

  ; -- decode-multipart: default content-type --
  (assert-equal test
    "text/plain"
    (FormPart.content-type
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n--abc--"
          "abc")
        0))
    "decode-multipart defaults content-type to text/plain")

  ; -- decode-multipart: no filename for text field --
  (assert-true test
    (Maybe.nothing?
      (FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n--abc--"
            "abc")
          0)))
    "decode-multipart has no filename for text field")

  ; -- decode-multipart: empty body --
  (assert-equal test
    0
    (Array.length &(Form.decode-multipart "" "abc"))
    "decode-multipart returns empty for empty body")

  ; -- decode-multipart: case-insensitive headers --
  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\ncontent-disposition: form-data; name=\"field1\"\r\n\r\nval\r\n--abc--"
          "abc")
        0))
    "decode-multipart handles lowercase headers")

  ; -- decode-multipart: case-insensitive param names --
  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(Form.decode-multipart
          "--abc\r\nContent-Disposition: form-data; Name=\"field1\"\r\n\r\nval\r\n--abc--"
          "abc")
        0))
    "decode-multipart handles uppercase param Name")

  (assert-equal test
    "test.txt"
    &(Maybe.unsafe-from
      @(FormPart.filename
        (Array.unsafe-nth
          &(Form.decode-multipart
            "--abc\r\nContent-Disposition: form-data; name=\"f\"; Filename=\"test.txt\"\r\n\r\ndata\r\n--abc--"
            "abc")
          0)))
    "decode-multipart handles uppercase Filename param")

  ; -- decode-multipart: transport padding on boundary --
  (assert-equal test
    1
    (Array.length
      &(Form.decode-multipart
        "--abc  \r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nval\r\n--abc--"
        "abc"))
    "decode-multipart tolerates padding after initial boundary")

  (assert-equal test
    2
    (Array.length
      &(Form.decode-multipart
        "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc \t\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
        "abc"))
    "decode-multipart tolerates padding between parts")

  ; -- decode-multipart-request: case-insensitive boundary param --
  (assert-equal test
    "hello"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart-request
          &(parse-req
            "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; Boundary=xyz\r\n\r\n--xyz\r\nContent-Disposition: form-data; name=\"msg\"\r\n\r\nhello\r\n--xyz--"))
        0))
    "decode-multipart-request handles uppercase Boundary param")

  ; -- multipart? --
  (assert-true test
    (Form.multipart?
      &(parse-req
        "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; boundary=abc\r\n\r\n"))
    "multipart? detects multipart content type")

  (assert-false test
    (Form.multipart?
      &(parse-req "POST / HTTP/1.1\r\nContent-Type: application/json\r\n\r\n"))
    "multipart? false for non-multipart")

  (assert-false test
    (Form.multipart? &(parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
    "multipart? false when no content-type")

  ; -- decode-multipart-request --
  (assert-equal test
    "hello"
    (FormPart.body
      (Array.unsafe-nth
        &(Form.decode-multipart-request
          &(parse-req
            "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; boundary=xyz\r\n\r\n--xyz\r\nContent-Disposition: form-data; name=\"msg\"\r\n\r\nhello\r\n--xyz--"))
        0))
    "decode-multipart-request parses from request")

  (assert-equal test
    0
    (Array.length
      &(Form.decode-multipart-request
        &(parse-req
          "POST / HTTP/1.1\r\nContent-Type: application/json\r\n\r\n{}")))
    "decode-multipart-request empty for non-multipart")

  ; ---------------------------------------------------------------------------
  ; Response.chunked status text
  ; ---------------------------------------------------------------------------

  (assert-equal test
    "OK"
    (Response.message &(Response.chunked 200 @"text/plain" &[@"hi"]))
    "chunked 200 has reason phrase OK")

  (assert-equal test
    "Not Found"
    (Response.message &(Response.chunked 404 @"text/plain" &[@"oops"]))
    "chunked 404 has reason phrase Not Found")

  (assert-equal test
    "Internal Server Error"
    (Response.message &(Response.chunked 500 @"text/plain" &[@"err"]))
    "chunked 500 has reason phrase Internal Server Error")

  ; ---------------------------------------------------------------------------
  ; Response finalization tests
  ; ---------------------------------------------------------------------------

  ; -- finalize omits Content-Length for chunked responses --
  (assert-false test
    (Map.contains?
      (Response.headers
        &(web-finalize-response
          (Response.chunked 200 @"text/plain" &[@"hello"])
          true))
      "Content-Length")
    "finalize omits Content-Length when Transfer-Encoding is set")

  ; -- finalize adds Content-Length for normal responses --
  (assert-true test
    (Map.contains?
      (Response.headers &(web-finalize-response (Response.text @"hi") true))
      "Content-Length")
    "finalize adds Content-Length for normal responses")

  ; ---------------------------------------------------------------------------
  ; log-after safety tests
  ; ---------------------------------------------------------------------------

  ; -- log-after does not crash when _start is missing --
  (assert-equal test
    200
    (let [req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          params (the (Map String String) {})]
      @(Response.code &(log-after &req &params (Response.text @"ok"))))
    "log-after does not crash without _start param")

  ; ---------------------------------------------------------------------------
  ; SHA1.hex-digest tests
  ; ---------------------------------------------------------------------------

  ; hex-digest returns a 40-char lowercase hex string
  (assert-true test
    (= 40 (String.length &(SHA1.hex-digest &(the (Array Byte) []))))
    "SHA1 hex-digest returns 40 chars")

  ; hex-digest is deterministic (same input -> same output)
  (assert-true test
    (=
      &(SHA1.hex-digest &(String.to-bytes "hello"))
      &(SHA1.hex-digest &(String.to-bytes "hello")))
    "SHA1 hex-digest is deterministic")

  ; different inputs produce different digests
  (assert-true test
    (/=
      &(SHA1.hex-digest &(String.to-bytes "hello"))
      &(SHA1.hex-digest &(String.to-bytes "world")))
    "SHA1 hex-digest differs for different inputs")

  ; ---------------------------------------------------------------------------
  ; HEAD method routing tests
  ; ---------------------------------------------------------------------------

  ; -- HEAD matches GET routes --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/hello" (fn [r p] (Response.text @"hi"))))
          req (parse-req "HEAD /hello HTTP/1.1\r\nHost: x\r\n\r\n")]
      (Maybe.just? &(web-find-handler (App.routes &app) &req)))
    "HEAD matches GET route")

  ; -- HEAD does not match POST routes --
  (assert-true test
    (let [app (-> (App.create)
                  (App.POST @"/data" (fn [r p] (Response.text @"ok"))))
          req (parse-req "HEAD /data HTTP/1.1\r\nHost: x\r\n\r\n")]
      (Maybe.nothing? &(web-find-handler (App.routes &app) &req)))
    "HEAD does not match POST route")

  ; -- HEAD response strips body --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/hello" (fn [r p] (Response.text @"hi"))))
          req @"HEAD /hello HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      (String.empty? (Response.body (Pair.a &pair))))
    "HEAD response has empty body")

  ; -- HEAD preserves Content-Length from GET body --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/hello" (fn [r p] (Response.text @"hi"))))
          req @"HEAD /hello HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)
          cl-vals (Map.get-with-default (Response.headers &resp)
                                        "Content-Length"
                                        &[@"0"])]
      (= (Array.unsafe-first &cl-vals) "2"))
    "HEAD preserves Content-Length from GET body")

  ; -- HEAD + chunked omits Content-Length (RFC 7230 §3.3.2) --
  (assert-false test
    (let [app (-> (App.create)
                  (App.GET @"/stream"
                           (fn [r p]
                             (Response.chunked 200 @"text/plain" &[@"hello"]))))
          req @"HEAD /stream HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)]
      (Map.contains? (Response.headers &resp) "Content-Length"))
    "HEAD + chunked omits Content-Length")

  ; -- HEAD + chunked preserves Transfer-Encoding --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/stream"
                           (fn [r p]
                             (Response.chunked 200 @"text/plain" &[@"hello"]))))
          req @"HEAD /stream HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)]
      (Map.contains? (Response.headers &resp) "Transfer-Encoding"))
    "HEAD + chunked preserves Transfer-Encoding")

  ; -- HEAD + chunked has empty body --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/stream"
                           (fn [r p]
                             (Response.chunked 200 @"text/plain" &[@"hello"]))))
          req @"HEAD /stream HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      (String.empty? (Response.body (Pair.a &pair))))
    "HEAD + chunked has empty body")

  ; ---------------------------------------------------------------------------
  ; ETag / If-None-Match tests
  ; ---------------------------------------------------------------------------

  ; -- web-etag-match? returns false without If-None-Match --
  (assert-false test
    (let [req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          resp (Response.with-header (Response.text @"hi") @"ETag" @"\"abc\"")]
      (web-etag-match? &req &resp))
    "etag-match? false without If-None-Match")

  ; -- web-etag-match? returns true on match --
  (assert-true test
    (let [req (parse-req
            "GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"abc\"\r\n\r\n")
          resp (Response.with-header (Response.text @"hi") @"ETag" @"\"abc\"")]
      (web-etag-match? &req &resp))
    "etag-match? true when ETags match")

  ; -- web-etag-match? returns false on mismatch --
  (assert-false test
    (let [req (parse-req
            "GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"xyz\"\r\n\r\n")
          resp (Response.with-header (Response.text @"hi") @"ETag" @"\"abc\"")]
      (web-etag-match? &req &resp))
    "etag-match? false when ETags differ")

  ; -- 304 Not Modified on matching ETag --
  (assert-equal test
    304
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"ETag"
                                                   @"\"abc\""))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"abc\"\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "matching If-None-Match returns 304")

  ; -- 304 preserves ETag header --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"ETag"
                                                   @"\"abc\""))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"abc\"\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)]
      (Map.contains? (Response.headers &resp) "ETag"))
    "304 response preserves ETag header")

  ; -- No 304 when ETags differ --
  (assert-equal test
    200
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"ETag"
                                                   @"\"abc\""))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"xyz\"\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "mismatched If-None-Match returns 200")

  ; -- finalize preserves explicit Content-Length --
  (assert-true test
    (let [resp (-> (Response.text @"")
                   (Response.with-header @"Content-Length" @"42"))
          final (web-finalize-response resp true)
          cl (Map.get-with-default (Response.headers &final)
                                   "Content-Length"
                                   &[@"0"])]
      (= (Array.unsafe-first &cl) "42"))
    "finalize preserves explicit Content-Length")

  ; ---------------------------------------------------------------------------
  ; Request validation tests
  ; ---------------------------------------------------------------------------

  ; -- valid-method? --
  (assert-true test (web-valid-method? "GET") "valid-method? accepts GET")

  (assert-true test (web-valid-method? "POST") "valid-method? accepts POST")

  (assert-true test
    (web-valid-method? "OPTIONS")
    "valid-method? accepts OPTIONS")

  (assert-false test
    (web-valid-method? "BREW")
    "valid-method? rejects unknown method")

  (assert-false test (web-valid-method? "") "valid-method? rejects empty string")

  ; -- validate-request-line: valid requests --
  (assert-true test
    (Maybe.nothing?
      &(web-validate-request-line
        &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n\r\n")))
    "validate accepts valid GET request")

  (assert-true test
    (Maybe.nothing?
      &(web-validate-request-line
        &(String.to-bytes "POST /data HTTP/1.0\r\nHost: x\r\n\r\n")))
    "validate accepts HTTP/1.0 POST")

  (assert-true test
    (Maybe.nothing?
      &(web-validate-request-line
        &(String.to-bytes "DELETE /item/42 HTTP/1.1\r\nHost: x\r\n\r\n")))
    "validate accepts DELETE with path")

  ; -- validate-request-line: bad HTTP version --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line
        &(String.to-bytes "GET / HTTP/2.0\r\nHost: x\r\n\r\n")))
    "validate rejects HTTP/2.0")

  (assert-true test
    (Maybe.just?
      &(web-validate-request-line
        &(String.to-bytes "GET / BLAH\r\nHost: x\r\n\r\n")))
    "validate rejects non-HTTP version")

  ; -- validate-request-line: unknown method --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line
        &(String.to-bytes "BREW / HTTP/1.1\r\nHost: x\r\n\r\n")))
    "validate rejects unknown method BREW")

  ; -- validate-request-line: missing version --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line &(String.to-bytes "GET /\r\nHost: x\r\n\r\n")))
    "validate rejects missing version")

  ; -- validate-request-line: no spaces --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line &(String.to-bytes "GARBAGE\r\n\r\n")))
    "validate rejects request line without spaces")

  ; -- validate-request-line: no CRLF --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line &(String.to-bytes "GET / HTTP/1.1")))
    "validate rejects missing CRLF")

  ; -- build-response returns 400 for malformed request --
  (assert-equal test
    400
    (let [app (-> (App.create) (App.GET @"/" (fn [r p] (Response.text @"hi"))))
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app
                                   &bh
                                   &ah
                                   &(String.to-bytes "INVALID\r\n\r\n"))]
      @(Response.code (Pair.a &pair)))
    "build-response returns 400 for garbage input"))
