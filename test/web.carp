(load "Test.carp")
(load "../web.carp")
(use Test)

(defn parse-req [s]
  (match (Request.parse s)
    (Result.Success r) r
    (Result.Error _) (Request.init @"GET" @"HTTP/1.1" (zero) [] {} @"")))

; unwraps a multipart decode the test expects to succeed
(defn parts-of [body boundary]
  (Result.unsafe-from-success (Form.decode-multipart body boundary)))

; feeds `s` to the gate in `read-size` byte reads, threading the chunk cursor
(defn replay-status [s read-size]
  (let-do [all (String.to-bytes s)
           n (Array.length &all)
           buf (the (Array Byte) [])
           cursor 0
           status 0
           i 0]
    (while (< i n)
      (let-do [stop (Int.min n (+ i read-size))]
        (while-do (< i stop)
          (Array.push-back! &buf @(Array.unsafe-nth &all i))
          (set! i (+ i 1)))
        (let-do [p (web-request-status &buf cursor)]
          (set! status @(Pair.a &p))
          (set! cursor @(Pair.b &p)))))
    status))

; `n` copies of U+00E4, so the byte length is twice the character count
(defn wide-chars [n]
  (let-do [bs (the (Array Byte) [])]
    (for [i 0 n]
      (do
        (Array.push-back! &bs (Byte.from-int 195))
        (Array.push-back! &bs (Byte.from-int 164))))
    (String.from-bytes &bs)))

(defn rr-tag [r]
  (match-ref r
    (RangeResolution.Full) 0
    (RangeResolution.Partial _ _) 1
    (RangeResolution.Unsatisfiable) 2))

(defn rr-start [r]
  (match-ref r
    (RangeResolution.Partial s _) @s
    (RangeResolution.Full) -1l
    (RangeResolution.Unsatisfiable) -1l))

(defn rr-end [r]
  (match-ref r
    (RangeResolution.Partial _ e) @e
    (RangeResolution.Full) -1l
    (RangeResolution.Unsatisfiable) -1l))

; builds the response for the raw request `raw` against a static-file app
; rooted at test/static-fixtures (index.html is 11 bytes)
(defn static-resp [raw]
  (let [app (StaticFile.mount (App.create) @"/static" @"test/static-fixtures")
        bh (the (Array (Fn [&Request &(Map String String)] (Maybe Response))) [])
        ah (the
          (Array (Fn [&Request &(Map String String) Response] Response))
          [])
        pair (web-build-response &app &bh &ah &(String.to-bytes raw))]
    @(Pair.a &pair)))

(defn header-val [resp name]
  @(Array.unsafe-first
    &(Map.get-with-default (Response.headers resp) name &[@""])))

; builds the 304 for a conditional GET, running `ah` as the after-hooks
(defn cached-304 [ah]
  (let [app (App.GET (App.create)
                     @"/"
                     (fn [-r -p]
                       (-> (Response.text @"hi")
                           (Response.with-header @"ETag" @"\"abc\"")
                           (Response.with-header @"Cache-Control"
                                                 @"max-age=60"))))
        bh (the (Array (Fn [&Request &(Map String String)] (Maybe Response))) [])
        raw @"GET / HTTP/1.1\r\nHost: x\r\nOrigin: http://a.test\r\nIf-None-Match: \"abc\"\r\n\r\n"
        pair (web-build-response &app &bh ah &(String.to-bytes &raw))]
    @(Pair.a &pair)))

; like `cached-304`, with the CORS after-hook configured for `origin`
(defn cors-304 [origin]
  (let-do [ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [CORS.after-hook])]
    (CORS.configure origin)
    (cached-304 &ah)))

(defn no-hooks []
  (the (Array (Fn [&Request &(Map String String) Response] Response)) []))

; matches `raw` against a single Server-Sent Events route at `pattern`
(defn sse-match [raw pattern]
  (web-try-sse &(String.to-bytes raw)
               &[(SSERoute.init @pattern (fn [event params s] ()))]))

(defn sse-idx [m] (match-ref m (Maybe.Just p) @(Pair.a p) (Maybe.Nothing) -1))

(defn sse-last-id [m]
  (match-ref m
    (Maybe.Just p)
      (match-ref (Pair.a (Pair.b p)) (Maybe.Just v) @v (Maybe.Nothing) @"none")
    (Maybe.Nothing) @"no-match"))

(defn sse-param [m k]
  (match-ref m
    (Maybe.Just p) (Map.get-with-default (Pair.b (Pair.b p)) k &@"none")
    (Maybe.Nothing) @"no-match"))

(deftest test
  ; -- Response.text --
  (assert-equal test
    200
    @(Response.code &(Response.text @"hi"))
    "text returns 200")

  (assert-equal test
    "hi"
    (Response.body &(Response.text @"hi"))
    "text sets body")

  ; -- Response.html --
  (assert-equal test
    200
    @(Response.code &(Response.html @"<h1>hi</h1>"))
    "html returns 200")

  ; -- Response.json --
  (assert-equal test
    200
    @(Response.code &(Response.json &(JSON.Null)))
    "json returns 200")
  (assert-equal test
    "null"
    (Response.body &(Response.json &(JSON.Null)))
    "json serializes body")
  (assert-equal test
    "1234567890"
    (Response.body &(Response.json &(JSON.Num 1234567890.0)))
    "json serializes a rowid-sized number without dropping digits")
  (assert-equal test
    "0.30000000000000004"
    (Response.body &(Response.json &(JSON.Num (+ 0.1 0.2))))
    "json serializes a double at full precision")
  (assert-equal test
    &(String.from-bytes &[34b 92b 110b 206b 177b 34b])
    (Response.body
      &(Response.json &(JSON.Str (String.from-bytes &[10b 206b 177b]))))
    "json keeps a code point that follows an escaped character")
  (assert-equal test
    &(String.from-bytes &[34b 104b 105b 128b 34b])
    (Response.body
      &(Response.json &(JSON.Str (String.from-bytes &[104b 105b 128b]))))
    "json leaves a byte that is not valid UTF-8 in place")

  ; -- Response.not-found --
  (assert-equal test
    404
    @(Response.code &(Response.not-found))
    "not-found returns 404")

  ; -- Response.bad-request --
  (assert-equal test
    400
    @(Response.code &(Response.bad-request))
    "bad-request returns 400")

  ; -- Response.redirect --
  (assert-equal test
    302
    @(Response.code &(Response.redirect @"/other"))
    "redirect returns 302")

  ; -- Response.with-header --
  (assert-equal test
    200
    @(Response.code
      &(Response.with-header (Response.text @"hi") @"X-Custom" @"val"))
    "with-header preserves status")

  ; -- Response.with-status --
  (assert-equal test
    201
    @(Response.code
      &(Response.with-status (Response.text @"created") 201 @"Created"))
    "with-status sets code")

  ; -- exact match --
  (assert-true test
    (Maybe.just? &(match-route "/hello" "/hello"))
    "exact path matches")

  (assert-true test
    (Maybe.nothing? &(match-route "/hello" "/world"))
    "different path does not match")

  (assert-true test
    (Maybe.nothing? &(match-route "/a/b" "/a"))
    "different length does not match")

  ; -- param capture --
  (assert-true test
    (Maybe.just? &(match-route "/users/:id" "/users/42"))
    "param route matches")

  (assert-equal test
    "42"
    &(Map.get
      &(match (match-route "/users/:id" "/users/42")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "id")
    "param route captures id")

  ; -- multiple params --
  (assert-equal test
    "posts"
    &(Map.get
      &(match (match-route "/users/:uid/:resource" "/users/1/posts")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "resource")
    "multi-param captures second param")

  ; -- root path --
  (assert-true test (Maybe.just? &(match-route "/" "/")) "root path matches")

  ; -- wildcard pattern --
  (assert-true test
    (Maybe.just? &(match-route "*" "/anything/at/all"))
    "wildcard pattern matches multi-segment path")

  (assert-true test
    (Maybe.just? &(match-route "*" "/"))
    "wildcard pattern matches root")

  ; -- content-type detection --
  (assert-equal test
    "text/html; charset=utf-8"
    &(Response.content-type-for "index.html")
    "content-type-for html")

  (assert-equal test
    "application/javascript; charset=utf-8"
    &(Response.content-type-for "/assets/index.js")
    "content-type-for js")

  (assert-equal test
    "application/octet-stream"
    &(Response.content-type-for "blob.unknown")
    "content-type-for unknown extension")

  ; -- safe-path? --
  (assert-true test
    (web-safe-path? "foo/bar/baz.txt")
    "safe-path? accepts a normal path")

  (assert-false test
    (web-safe-path? "foo/../etc/passwd")
    "safe-path? rejects ..")

  ; -- before-hook short-circuit --
  (assert-true test
    (let [params (the (Map String String) {})]
      (Maybe.just?
        &(web-run-before
          &[(fn [req p] (Maybe.Just (Response.text @"blocked")))]
          &(parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          &params)))
    "before-hook can short-circuit")

  ; -- before-hook annotates params --
  (assert-true test
    (let-do [params (the (Map String String) {})
             req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")]
      (ignore
        (web-run-before
          &[(fn [r p] (do (Map.put! p &@"_tagged" &@"yes") (Maybe.Nothing)))]
          &req
          &params))
      (Map.contains? &params "_tagged"))
    "before-hook can annotate params")

  ; -- after-hook modifies response --
  (assert-equal test
    201
    (let-do [params (the (Map String String) {})
             req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
             resp (web-run-after
               &[(fn [r p resp] (Response.with-status resp 201 @"Created"))]
               &req
               &params
               (Response.text @"ok"))]
      @(Response.code &resp))
    "after-hook can modify status code")

  ; -- prefix glob route --
  (assert-true test
    (Maybe.just? &(match-route "/api/*" "/api/foo/bar"))
    "prefix glob matches multi-segment tail")

  (assert-equal test
    "foo/bar"
    &(Map.get
      &(match (match-route "/api/*" "/api/foo/bar")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "*")
    "prefix glob captures tail as *")

  (assert-true test
    (Maybe.nothing? &(match-route "/api/*" "/other/foo"))
    "prefix glob rejects non-matching prefix")

  (assert-true test
    (Maybe.just? &(match-route "/users/:id/*" "/users/42/posts"))
    "prefix glob with named captures matches")

  (assert-equal test
    "42"
    &(Map.get
      &(match (match-route "/users/:id/*" "/users/42/posts/1")
        (Maybe.Just m) m
        (Maybe.Nothing) {})
      "id")
    "prefix glob preserves named captures")

  ; -- form parsing --
  (assert-equal test
    "bar"
    &(Map.get &(Form.decode "foo=bar&baz=qux") "foo")
    "Form.decode extracts key")

  (assert-equal test
    "hello world"
    &(Map.get &(Form.decode "msg=hello+world") "msg")
    "Form.decode does not decode + as space")

  (assert-equal test
    "hello world"
    &(Map.get &(Form.decode "msg=hello%20world") "msg")
    "Form.decode decodes percent-encoding")

  (assert-equal test
    ""
    &(Map.get &(Form.decode "flag&other=1") "flag")
    "Form.decode handles key without value")

  (assert-equal test
    3
    (let [app (-> (App.create)
                  (App.GET @"/a" (fn [r p] (Response.text @"")))
                  (App.POST @"/b" (fn [r p] (Response.text @"")))
                  (App.DELETE @"/c" (fn [r p] (Response.text @""))))]
      (Array.length (App.routes &app)))
    "app accumulates routes")

  ; -- decode-multipart: single text field --
  (assert-equal test
    1
    (Array.length
      &(parts-of
        "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
        "abc"))
    "decode-multipart parses single part")

  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(parts-of
          "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts name")

  (assert-equal test
    "value1"
    (FormPart.body
      (Array.unsafe-nth
        &(parts-of
          "--abc\r\nContent-Disposition: form-data; name=\"field1\"\r\n\r\nvalue1\r\n--abc--"
          "abc")
        0))
    "decode-multipart extracts body")

  ; -- decode-multipart: multiple parts --
  (assert-equal test
    2
    (Array.length
      &(parts-of
        "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
        "abc"))
    "decode-multipart parses two parts")

  (assert-equal test
    "val-b"
    (FormPart.body
      (Array.unsafe-nth
        &(parts-of
          "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
          "abc")
        1))
    "decode-multipart extracts second part body")

  ; -- decode-multipart: file upload with filename and content-type --
  (assert-true test
    (Maybe.just?
      (FormPart.filename
        (Array.unsafe-nth
          &(parts-of
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart detects filename")

  (assert-equal test
    "test.txt"
    &(Maybe.unsafe-from
      @(FormPart.filename
        (Array.unsafe-nth
          &(parts-of
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart extracts filename value")

  (assert-equal test
    "text/plain"
    &(Maybe.unsafe-from
      @(FormPart.content-type
        (Array.unsafe-nth
          &(parts-of
            "--abc\r\nContent-Disposition: form-data; name=\"file1\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\nfile data\r\n--abc--"
            "abc")
          0)))
    "decode-multipart extracts content-type")

  ; -- decode-multipart: a part without Content-Type reports none --
  (assert-true test
    (Maybe.nothing?
      (FormPart.content-type
        (Array.unsafe-nth
          &(parts-of
            "--abc\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n--abc--"
            "abc")
          0)))
    "decode-multipart reports no content-type when the part carries none")

  ; -- decode-multipart: no filename for text field --
  (assert-true test
    (Maybe.nothing?
      (FormPart.filename
        (Array.unsafe-nth
          &(parts-of
            "--abc\r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nv\r\n--abc--"
            "abc")
          0)))
    "decode-multipart has no filename for text field")

  ; -- decode-multipart: empty body --
  (assert-true test
    (Result.error? &(Form.decode-multipart "" "abc"))
    "decode-multipart fails for empty body")

  ; -- decode-multipart: case-insensitive headers --
  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(parts-of
          "--abc\r\ncontent-disposition: form-data; name=\"field1\"\r\n\r\nval\r\n--abc--"
          "abc")
        0))
    "decode-multipart handles lowercase headers")

  ; -- decode-multipart: case-insensitive param names --
  (assert-equal test
    "field1"
    (FormPart.name
      (Array.unsafe-nth
        &(parts-of
          "--abc\r\nContent-Disposition: form-data; Name=\"field1\"\r\n\r\nval\r\n--abc--"
          "abc")
        0))
    "decode-multipart handles uppercase param Name")

  (assert-equal test
    "test.txt"
    &(Maybe.unsafe-from
      @(FormPart.filename
        (Array.unsafe-nth
          &(parts-of
            "--abc\r\nContent-Disposition: form-data; name=\"f\"; Filename=\"test.txt\"\r\n\r\ndata\r\n--abc--"
            "abc")
          0)))
    "decode-multipart handles uppercase Filename param")

  ; -- decode-multipart: transport padding on boundary --
  (assert-equal test
    1
    (Array.length
      &(parts-of
        "--abc  \r\nContent-Disposition: form-data; name=\"f\"\r\n\r\nval\r\n--abc--"
        "abc"))
    "decode-multipart tolerates padding after initial boundary")

  (assert-equal test
    2
    (Array.length
      &(parts-of
        "--abc\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nval-a\r\n--abc \t\r\nContent-Disposition: form-data; name=\"b\"\r\n\r\nval-b\r\n--abc--"
        "abc"))
    "decode-multipart tolerates padding between parts")

  ; -- decode-multipart-request: case-insensitive boundary param --
  (assert-equal test
    "hello"
    (FormPart.body
      (Array.unsafe-nth
        &(Result.unsafe-from-success
          (Form.decode-multipart-request
            &(parse-req
              "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; Boundary=xyz\r\n\r\n--xyz\r\nContent-Disposition: form-data; name=\"msg\"\r\n\r\nhello\r\n--xyz--")))
        0))
    "decode-multipart-request handles uppercase Boundary param")

  ; -- decode-multipart-request: non-multipart request fails --
  (assert-true test
    (Result.error?
      &(Form.decode-multipart-request
        &(parse-req
          "POST / HTTP/1.1\r\nContent-Type: application/json\r\n\r\n{}")))
    "decode-multipart-request fails for non-multipart content type")

  ; -- multipart? --
  (assert-true test
    (Form.multipart?
      &(parse-req
        "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; boundary=abc\r\n\r\n"))
    "multipart? detects multipart content type")

  (assert-false test
    (Form.multipart?
      &(parse-req "POST / HTTP/1.1\r\nContent-Type: application/json\r\n\r\n"))
    "multipart? false for non-multipart")

  (assert-false test
    (Form.multipart? &(parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
    "multipart? false when no content-type")

  ; -- case-insensitive request-header reads (RFC 7230 §3.2) --
  (assert-equal test
    "bar"
    &(Map.get
      &(Form.decode-request
        &(parse-req
          "POST / HTTP/1.1\r\ncontent-type: application/x-www-form-urlencoded\r\n\r\nfoo=bar"))
      "foo")
    "decode-request reads a lowercase content-type header")

  (assert-false test
    (web-keep-alive? &(parse-req "GET / HTTP/1.1\r\nconnection: close\r\n\r\n"))
    "keep-alive? honors a lowercase connection: close")

  (assert-true test
    (web-keep-alive?
      &(parse-req "GET / HTTP/1.1\r\nConnection: keep-alive\r\n\r\n"))
    "keep-alive? true for Connection: keep-alive")

  (assert-true test
    (web-keep-alive? &(parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
    "keep-alive? defaults to keep-alive on HTTP/1.1 without Connection")

  ; -- case-insensitive Connection option tokens (RFC 9110 §7.6.1) --
  (assert-false test
    (web-keep-alive? &(parse-req "GET / HTTP/1.1\r\nConnection: CLOSE\r\n\r\n"))
    "keep-alive? honors an uppercase close token")

  (assert-false test
    (web-keep-alive? &(parse-req "GET / HTTP/1.1\r\nConnection: Close\r\n\r\n"))
    "keep-alive? honors a capitalized close token")

  (assert-false test
    (web-keep-alive?
      &(parse-req "GET / HTTP/1.1\r\nConnection: close, TE\r\n\r\n"))
    "keep-alive? honors close as the first of several options")

  (assert-false test
    (web-keep-alive?
      &(parse-req "GET / HTTP/1.1\r\nConnection: TE, close\r\n\r\n"))
    "keep-alive? honors close as the last of several options")

  (assert-true test
    (web-keep-alive?
      &(parse-req "GET / HTTP/1.1\r\nConnection: Keep-Alive\r\n\r\n"))
    "keep-alive? true for a capitalized keep-alive token")

  (assert-true test
    (web-keep-alive? &(parse-req "GET / HTTP/1.1\r\nConnection: TE\r\n\r\n"))
    "keep-alive? true for an unrecognised option")

  (assert-false test
    (web-keep-alive? &(parse-req "GET / HTTP/1.0\r\nHost: x\r\n\r\n"))
    "keep-alive? defaults to close on HTTP/1.0 without Connection")

  ; -- repeated Connection field lines (RFC 9110 §5.3) --
  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: keep-alive\r\nConnection: close\r\n\r\n"))
    "keep-alive? honors close on a later Connection line")

  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: close\r\nConnection: keep-alive\r\n\r\n"))
    "keep-alive? honors close on an earlier Connection line")

  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: TE\r\nConnection: Keep-Alive, CLOSE\r\n\r\n"))
    "keep-alive? honors a close token in any of several Connection lines")

  (assert-true test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: TE\r\nConnection: keep-alive\r\n\r\n"))
    "keep-alive? true when no Connection line lists close")

  ; -- repeated Connection lines differing in field-name case (RFC 9110 §5.1) --
  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: close\r\nconnection: keep-alive\r\n\r\n"))
    "keep-alive? honors close on a differently cased earlier Connection line")

  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nconnection: keep-alive\r\nConnection: close\r\n\r\n"))
    "keep-alive? honors close on a differently cased later Connection line")

  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nCONNECTION: close\r\nConnection: keep-alive\r\n\r\n"))
    "keep-alive? honors close on an upper-case CONNECTION line")

  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: keep-alive\r\nCONNECTION: close\r\n\r\n"))
    "keep-alive? honors a trailing upper-case CONNECTION: close")

  (assert-false test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: close\r\nconnection: keep-alive\r\nCONNECTION: TE\r\n\r\n"))
    "keep-alive? honors close among three case variants of Connection")

  (assert-true test
    (web-keep-alive?
      &(parse-req
        "GET / HTTP/1.1\r\nConnection: TE\r\nconnection: keep-alive\r\n\r\n"))
    "keep-alive? true when no cased Connection variant lists close")

  ; -- decode-multipart-request --
  (assert-equal test
    "hello"
    (FormPart.body
      (Array.unsafe-nth
        &(Result.unsafe-from-success
          (Form.decode-multipart-request
            &(parse-req
              "POST / HTTP/1.1\r\nContent-Type: multipart/form-data; boundary=xyz\r\n\r\n--xyz\r\nContent-Disposition: form-data; name=\"msg\"\r\n\r\nhello\r\n--xyz--")))
        0))
    "decode-multipart-request parses from request")

  (assert-equal test
    "OK"
    (Response.message &(Response.chunked 200 @"text/plain" &[@"hi"]))
    "chunked 200 has reason phrase OK")

  (assert-equal test
    "Not Found"
    (Response.message &(Response.chunked 404 @"text/plain" &[@"oops"]))
    "chunked 404 has reason phrase Not Found")

  (assert-equal test
    "Internal Server Error"
    (Response.message &(Response.chunked 500 @"text/plain" &[@"err"]))
    "chunked 500 has reason phrase Internal Server Error")

  ; -- finalize omits Content-Length for chunked responses --
  (assert-false test
    (Map.contains?
      (Response.headers
        &(web-finalize-response
          (Response.chunked 200 @"text/plain" &[@"hello"])
          true))
      "Content-Length")
    "finalize omits Content-Length when Transfer-Encoding is set")

  ; -- finalize adds Content-Length for normal responses --
  (assert-true test
    (Map.contains?
      (Response.headers &(web-finalize-response (Response.text @"hi") true))
      "Content-Length")
    "finalize adds Content-Length for normal responses")

  ; -- log-after does not crash when _start is missing --
  (assert-equal test
    200
    (let [req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          params (the (Map String String) {})]
      @(Response.code &(log-after &req &params (Response.text @"ok"))))
    "log-after does not crash without _start param")

  ; hex-digest returns a 40-char lowercase hex string
  (assert-true test
    (= 40 (String.length &(SHA1.hex-digest &(the (Array Byte) []))))
    "SHA1 hex-digest returns 40 chars")

  (assert-equal test
    "a9993e364706816aba3e25717850c26c9cd0d89d"
    &(SHA1.hex-digest &(String.to-bytes "abc"))
    "SHA1 hex-digest matches the known vector for 'abc'")

  ; hex-digest is deterministic (same input -> same output)
  (assert-true test
    (=
      &(SHA1.hex-digest &(String.to-bytes "hello"))
      &(SHA1.hex-digest &(String.to-bytes "hello")))
    "SHA1 hex-digest is deterministic")

  ; different inputs produce different digests
  (assert-true test
    (/=
      &(SHA1.hex-digest &(String.to-bytes "hello"))
      &(SHA1.hex-digest &(String.to-bytes "world")))
    "SHA1 hex-digest differs for different inputs")

  ; -- HEAD matches GET routes --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/hello" (fn [r p] (Response.text @"hi"))))
          req (parse-req "HEAD /hello HTTP/1.1\r\nHost: x\r\n\r\n")]
      (Maybe.just? &(web-find-handler (App.routes &app) &req)))
    "HEAD matches GET route")

  ; -- HEAD does not match POST routes --
  (assert-true test
    (let [app (-> (App.create)
                  (App.POST @"/data" (fn [r p] (Response.text @"ok"))))
          req (parse-req "HEAD /data HTTP/1.1\r\nHost: x\r\n\r\n")]
      (Maybe.nothing? &(web-find-handler (App.routes &app) &req)))
    "HEAD does not match POST route")

  ; -- HEAD response strips body --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/hello" (fn [r p] (Response.text @"hi"))))
          req @"HEAD /hello HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      (String.empty? (Response.body (Pair.a &pair))))
    "HEAD response has empty body")

  ; -- HEAD preserves Content-Length from GET body --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/hello" (fn [r p] (Response.text @"hi"))))
          req @"HEAD /hello HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)
          cl-vals (Map.get-with-default (Response.headers &resp)
                                        "Content-Length"
                                        &[@"0"])]
      (= (Array.unsafe-first &cl-vals) "2"))
    "HEAD preserves Content-Length from GET body")

  ; -- HEAD + chunked omits Content-Length (RFC 7230 §3.3.2) --
  (assert-false test
    (let [app (-> (App.create)
                  (App.GET @"/stream"
                           (fn [r p]
                             (Response.chunked 200 @"text/plain" &[@"hello"]))))
          req @"HEAD /stream HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)]
      (Map.contains? (Response.headers &resp) "Content-Length"))
    "HEAD + chunked omits Content-Length")

  ; -- HEAD + chunked preserves Transfer-Encoding --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/stream"
                           (fn [r p]
                             (Response.chunked 200 @"text/plain" &[@"hello"]))))
          req @"HEAD /stream HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)]
      (Map.contains? (Response.headers &resp) "Transfer-Encoding"))
    "HEAD + chunked preserves Transfer-Encoding")

  ; -- HEAD + chunked has empty body --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/stream"
                           (fn [r p]
                             (Response.chunked 200 @"text/plain" &[@"hello"]))))
          req @"HEAD /stream HTTP/1.1\r\nHost: x\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      (String.empty? (Response.body (Pair.a &pair))))
    "HEAD + chunked has empty body")

  ; -- Range resolution: bytes=A-B --
  (assert-equal test
    1
    (rr-tag &(web-resolve-range "bytes=0-499" 1000l))
    "bytes=0-499 is a partial range")
  (assert-equal test
    0l
    (rr-start &(web-resolve-range "bytes=0-499" 1000l))
    "bytes=0-499 starts at 0")
  (assert-equal test
    499l
    (rr-end &(web-resolve-range "bytes=0-499" 1000l))
    "bytes=0-499 ends at 499")

  ; -- Range resolution: bytes=A- (open-ended) --
  (assert-equal test
    500l
    (rr-start &(web-resolve-range "bytes=500-" 1000l))
    "bytes=500- starts at 500")
  (assert-equal test
    999l
    (rr-end &(web-resolve-range "bytes=500-" 1000l))
    "bytes=500- runs to EOF")

  ; -- Range resolution: bytes=-N (suffix) --
  (assert-equal test
    500l
    (rr-start &(web-resolve-range "bytes=-500" 1000l))
    "bytes=-500 starts 500 bytes before EOF")
  (assert-equal test
    999l
    (rr-end &(web-resolve-range "bytes=-500" 1000l))
    "bytes=-500 ends at EOF")

  ; -- Range resolution: bytes=0- covers the whole file --
  (assert-equal test
    0l
    (rr-start &(web-resolve-range "bytes=0-" 1000l))
    "bytes=0- starts at 0")
  (assert-equal test
    999l
    (rr-end &(web-resolve-range "bytes=0-" 1000l))
    "bytes=0- ends at EOF")

  ; -- Range resolution: end past EOF is clamped --
  (assert-equal test
    999l
    (rr-end &(web-resolve-range "bytes=0-100000" 1000l))
    "bytes=0-100000 clamps end to EOF")
  (assert-equal test
    1
    (rr-tag &(web-resolve-range "bytes=0-100000" 1000l))
    "bytes=0-100000 stays satisfiable after clamping")

  ; -- Range resolution: start at/past size is unsatisfiable --
  (assert-equal test
    2
    (rr-tag &(web-resolve-range "bytes=2000-3000" 1000l))
    "bytes=2000-3000 past EOF is unsatisfiable")
  (assert-equal test
    2
    (rr-tag &(web-resolve-range "bytes=1000-1000" 1000l))
    "start equal to size is unsatisfiable")

  ; -- Range resolution: malformed specs fall back to full --
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "bytes=abc" 1000l))
    "bytes=abc falls back to full")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "bytes=" 1000l))
    "bytes= falls back to full")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "0-499" 1000l))
    "missing bytes= falls back to full")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "bytes=1-2-3" 1000l))
    "extra dash falls back to full")

  ; -- Range resolution: a range-set is served from its first satisfiable spec --
  (assert-equal test
    0l
    (rr-start &(web-resolve-range "bytes=0-499,600-700" 1000l))
    "a multi-range set is answered with its first range")
  (assert-equal test
    499l
    (rr-end &(web-resolve-range "bytes=0-499,600-700" 1000l))
    "a multi-range set ends at its first range")
  (assert-equal test
    800l
    (rr-start &(web-resolve-range "bytes=2000-3000, -200" 1000l))
    "a multi-range set skips a leading unsatisfiable spec")
  (assert-equal test
    2
    (rr-tag &(web-resolve-range "bytes=2000-3000, 4000-5000" 1000l))
    "a wholly unsatisfiable range-set is a 416")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "bytes=0-499,abc" 1000l))
    "one invalid spec discards the whole range-set")

  ; -- Range resolution: RFC 9110 grammar --
  (assert-equal test
    499l
    (rr-end &(web-resolve-range "BYTES=0-499" 1000l))
    "the range unit is case-insensitive")
  (assert-equal test
    0l
    (rr-start &(web-resolve-range "bytes = 0-499" 1000l))
    "whitespace around the range-set is ignored")
  (assert-equal test
    499l
    (rr-end &(web-resolve-range "bytes=, 0-499, " 1000l))
    "empty range-set elements are ignored")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "items=0-499" 1000l))
    "an unknown range unit falls back to full")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range "bytes=499-0" 1000l))
    "a last-pos below its first-pos falls back to full")

  ; -- Range resolution: zero-length suffix and empty files --
  (assert-equal test
    2
    (rr-tag &(web-resolve-range "bytes=-0" 1000l))
    "bytes=-0 is unsatisfiable")
  (assert-equal test
    2
    (rr-tag &(web-resolve-range "bytes=0-" 0l))
    "any range on an empty file is unsatisfiable")

  ; -- Range resolution: oversized bounds do not overflow --
  (assert-equal test
    2
    (rr-tag &(web-resolve-range "bytes=999999999999-" 1000l))
    "oversized start saturates to unsatisfiable")
  (assert-equal test
    999l
    (rr-end &(web-resolve-range "bytes=-999999999999" 1000l))
    "oversized suffix saturates to the whole file")

  ; -- Client-controlled strings whose byte length exceeds their char count --
  (assert-equal test
    0
    (rr-tag &(web-resolve-range &(wide-chars 5) 1000l))
    "a non-ASCII Range header falls back to full")
  (assert-equal test
    0
    (rr-tag &(web-resolve-range &(String.append "bytes=" &(wide-chars 5)) 1000l))
    "a non-ASCII range-set falls back to full")
  (assert-equal test
    200
    @(Response.code
      &(static-resp
        &(fmt
          "HEAD /static/index.html HTTP/1.1\r\nRange: %s\r\n\r\n"
          &(wide-chars 5))))
    "a non-ASCII Range header serves the whole representation")
  (assert-equal test
    "11"
    &(header-val
      &(static-resp
        &(fmt
          "HEAD /static/index.html HTTP/1.1\r\nRange: %s\r\n\r\n"
          &(wide-chars 5)))
      "Content-Length")
    "a non-ASCII Range header keeps the full Content-Length")
  (assert-equal test
    0
    (Map.length
      &(Form.decode-request
        &(parse-req
          &(fmt
            "POST / HTTP/1.1\r\nContent-Type: %s\r\nContent-Length: 3\r\n\r\na=1"
            &(wide-chars 20)))))
    "a non-ASCII Content-Type decodes no urlencoded form")
  (assert-equal test
    false
    (Form.multipart?
      &(parse-req
        &(fmt
          "POST / HTTP/1.1\r\nContent-Type: %s\r\nContent-Length: 3\r\n\r\na=1"
          &(wide-chars 20))))
    "a non-ASCII Content-Type is not multipart")
  (assert-equal test
    "x"
    &(Map.get-with-default
      &(Form.decode &(String.append &(wide-chars 3) "=x"))
      &(wide-chars 3)
      &@"")
    "a non-ASCII form key keeps its value")
  (assert-equal test
    "text/html; charset=utf-8"
    &(Response.content-type-for &(String.append &(wide-chars 3) ".html"))
    "a non-ASCII path still matches its extension")
  (assert-equal test
    404
    @(Response.code
      &(StaticFile.serve "test/static-fixtures"
                         &(String.append &(wide-chars 4) "/")
                         &[@"index.html"]))
    "a missing non-ASCII directory path is a 404")
  (assert-equal test
    200
    @(Response.code
      &(StaticFile.serve "test/static-fixtures"
                         &(String.append &(wide-chars 2) "/")
                         &[@"index.html"]))
    "an existing non-ASCII directory path finds its index file")
  (assert-equal test
    &(fmt "test/static-fixtures/%s/index.html" &(wide-chars 2))
    &(header-val
      &(StaticFile.serve "test/static-fixtures"
                         &(String.append &(wide-chars 2) "/")
                         &[@"index.html"])
      "X-Sendfile")
    "a non-ASCII directory index is resolved without a stray separator")
  (assert-equal test
    "text/html; charset=utf-8"
    &(header-val
      &(StaticFile.serve "test/static-fixtures"
                         &(String.append &(wide-chars 2) "/")
                         &[@"index.html"])
      "Content-Type")
    "a non-ASCII directory index is served as HTML")
  (assert-true test
    (web-ends-with? &(String.append &(wide-chars 4) "/") "/")
    "web-ends-with? measures the suffix in bytes")
  (assert-equal test
    false
    (web-starts-with? &(wide-chars 5) "0123456789")
    "web-starts-with? measures the prefix in bytes")

  ; -- HEAD with a satisfiable range answers 206 --
  (assert-equal test
    206
    @(Response.code
      &(static-resp
        "HEAD /static/index.html HTTP/1.1\r\nRange: bytes=0-4\r\n\r\n"))
    "HEAD range request returns 206")
  (assert-equal test
    "bytes 0-4/11"
    &(header-val
      &(static-resp
        "HEAD /static/index.html HTTP/1.1\r\nRange: bytes=0-4\r\n\r\n")
      "Content-Range")
    "HEAD range request sets Content-Range")
  (assert-equal test
    "5"
    &(header-val
      &(static-resp
        "HEAD /static/index.html HTTP/1.1\r\nRange: bytes=0-4\r\n\r\n")
      "Content-Length")
    "HEAD range request sets range-length Content-Length")
  (assert-true test
    (String.empty?
      (Response.body
        &(static-resp
          "HEAD /static/index.html HTTP/1.1\r\nRange: bytes=0-4\r\n\r\n")))
    "HEAD range request has no body")

  ; -- HEAD with an unsatisfiable range answers 416 --
  (assert-equal test
    416
    @(Response.code
      &(static-resp
        "HEAD /static/index.html HTTP/1.1\r\nRange: bytes=100-200\r\n\r\n"))
    "HEAD unsatisfiable range returns 416")
  (assert-equal test
    "bytes */11"
    &(header-val
      &(static-resp
        "HEAD /static/index.html HTTP/1.1\r\nRange: bytes=100-200\r\n\r\n")
      "Content-Range")
    "HEAD 416 sets Content-Range with the total size")

  ; -- normal static responses advertise range support --
  (assert-equal test
    "bytes"
    &(header-val
      &(static-resp "HEAD /static/index.html HTTP/1.1\r\n\r\n")
      "Accept-Ranges")
    "static HEAD advertises Accept-Ranges")
  (assert-equal test
    200
    @(Response.code &(static-resp "HEAD /static/index.html HTTP/1.1\r\n\r\n"))
    "static HEAD without a range stays 200")

  ; -- chunked request body reaches the handler decoded --
  (assert-equal test
    "hello world"
    (Response.body
      (Pair.a
        &(let [app (-> (App.create)
                       (App.POST @"/echo"
                                 (fn [r p] (Response.text @(Request.body r)))))
               req @"POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nhello \r\n5\r\nworld\r\n0\r\n\r\n"
               bh (the
                 (Array (Fn [&Request &(Map String String)] (Maybe Response)))
                 [])
               ah (the
                 (Array (Fn [&Request &(Map String String) Response] Response))
                 [])]
          (web-build-response &app &bh &ah &(String.to-bytes &req)))))
    "chunked request body is dechunked before dispatch")

  ; -- a non-chunked body is handed through untouched --
  (assert-equal test
    "6\r\nhello \r\n0\r\n\r\n"
    (Response.body
      (Pair.a
        &(let [app (-> (App.create)
                       (App.POST @"/echo"
                                 (fn [r p] (Response.text @(Request.body r)))))
               req @"POST /echo HTTP/1.1\r\nHost: x\r\nContent-Length: 15\r\n\r\n6\r\nhello \r\n0\r\n\r\n"
               bh (the
                 (Array (Fn [&Request &(Map String String)] (Maybe Response)))
                 [])
               ah (the
                 (Array (Fn [&Request &(Map String String) Response] Response))
                 [])]
          (web-build-response &app &bh &ah &(String.to-bytes &req)))))
    "Content-Length body is not dechunked")

  ; -- malformed chunk framing --
  (assert-equal test
    400
    @(Response.code
      (Pair.a
        &(let [app (-> (App.create)
                       (App.POST @"/echo"
                                 (fn [r p] (Response.text @(Request.body r)))))
               req @"POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nhello\r\n0\r\n\r\n"
               bh (the
                 (Array (Fn [&Request &(Map String String)] (Maybe Response)))
                 [])
               ah (the
                 (Array (Fn [&Request &(Map String String) Response] Response))
                 [])]
          (web-build-response &app &bh &ah &(String.to-bytes &req)))))
    "undecodable chunked body is a 400")

  (assert-equal test
    "hello"
    (Response.body
      (Pair.a
        &(let [app (-> (App.create)
                       (App.POST @"/echo"
                                 (fn [r p] (Response.text @(Request.body r)))))
               req @"POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
               bh (the
                 (Array (Fn [&Request &(Map String String)] (Maybe Response)))
                 [])
               ah (the
                 (Array (Fn [&Request &(Map String String) Response] Response))
                 [])]
          (web-build-response &app &bh &ah &(String.to-bytes &req)))))
    "a duplicate Transfer-Encoding with chunked last is decoded")

  (assert-equal test
    "hello"
    (Response.body
      (Pair.a
        &(let [app (-> (App.create)
                       (App.POST @"/echo"
                                 (fn [r p] (Response.text @(Request.body r)))))
               req @"POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\ntransfer-encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
               bh (the
                 (Array (Fn [&Request &(Map String String)] (Maybe Response)))
                 [])
               ah (the
                 (Array (Fn [&Request &(Map String String) Response] Response))
                 [])]
          (web-build-response &app &bh &ah &(String.to-bytes &req)))))
    "a mixed-case repeated Transfer-Encoding with chunked last is decoded")

  ; -- a decoded chunked request is normalized --
  (assert-equal test
    "plain 11"
    (Response.body
      (Pair.a
        &(let [app (-> (App.create)
                       (App.POST @"/echo"
                                 (fn [r p]
                                   (Response.text
                                     (fmt "%s %s"
                                          (if (Request.chunked? r)
                                            "chunked"
                                            "plain")
                                          &(match (Request.header r
                                                                  "Content-Length")
                                            (Maybe.Just v) v
                                            (Maybe.Nothing) @"none"))))))
               req @"POST /echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nhello \r\n5\r\nworld\r\n0\r\n\r\n"
               bh (the
                 (Array (Fn [&Request &(Map String String)] (Maybe Response)))
                 [])
               ah (the
                 (Array (Fn [&Request &(Map String String) Response] Response))
                 [])]
          (web-build-response &app &bh &ah &(String.to-bytes &req)))))
    "a decoded chunked request drops Transfer-Encoding and gains Content-Length")

  ; -- web-etag-match? returns false without If-None-Match --
  (assert-false test
    (let [req (parse-req "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
          resp (Response.with-header (Response.text @"hi") @"ETag" @"\"abc\"")]
      (web-etag-match? &req &resp))
    "etag-match? false without If-None-Match")

  ; -- web-etag-match? returns true on match --
  (assert-true test
    (let [req (parse-req
            "GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"abc\"\r\n\r\n")
          resp (Response.with-header (Response.text @"hi") @"ETag" @"\"abc\"")]
      (web-etag-match? &req &resp))
    "etag-match? true when ETags match")

  ; -- web-etag-match? returns false on mismatch --
  (assert-false test
    (let [req (parse-req
            "GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"xyz\"\r\n\r\n")
          resp (Response.with-header (Response.text @"hi") @"ETag" @"\"abc\"")]
      (web-etag-match? &req &resp))
    "etag-match? false when ETags differ")

  ; -- 304 Not Modified on matching ETag --
  (assert-equal test
    304
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"ETag"
                                                   @"\"abc\""))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"abc\"\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "matching If-None-Match returns 304")

  ; -- 304 preserves ETag header --
  (assert-true test
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"ETag"
                                                   @"\"abc\""))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"abc\"\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))
          resp @(Pair.a &pair)]
      (Map.contains? (Response.headers &resp) "ETag"))
    "304 response preserves ETag header")

  ; -- 304 keeps the caching and negotiation headers the 200 carried --
  (assert-equal test
    "max-age=60"
    &(header-val &(cached-304 &(no-hooks)) "Cache-Control")
    "304 keeps Cache-Control")
  (assert-equal test
    "http://a.test"
    &(header-val &(cors-304 @"http://a.test") "Access-Control-Allow-Origin")
    "304 keeps the CORS after-hook's Access-Control-Allow-Origin")
  (assert-equal test
    "Origin"
    &(header-val &(cors-304 @"http://a.test") "Vary")
    "304 keeps the CORS after-hook's Vary")

  ; -- 304 drops the representation and framing headers --
  (assert-false test
    (Map.contains? (Response.headers &(cached-304 &(no-hooks))) "Content-Type")
    "304 drops Content-Type")
  (assert-true test
    (String.empty? (Response.body &(cached-304 &(no-hooks))))
    "304 has no body")
  (assert-equal test
    "0"
    &(header-val
      &(web-finalize-response (cached-304 &(no-hooks)) true)
      "Content-Length")
    "a finalized 304 sends Content-Length: 0")

  ; -- a sendfile 304 leaves the transfer machinery disarmed --
  (assert-equal test
    304
    @(Response.code
      &(static-resp
        "GET /static/index.html HTTP/1.1\r\nRange: bytes=0-1\r\nIf-Modified-Since: Fri, 31 Dec 2100 23:59:59 GMT\r\n\r\n"))
    "a ranged conditional GET for a static file returns 304")
  (assert-false test
    (Map.contains?
      (Response.headers
        &(static-resp
          "GET /static/index.html HTTP/1.1\r\nRange: bytes=0-1\r\nIf-Modified-Since: Fri, 31 Dec 2100 23:59:59 GMT\r\n\r\n"))
      "X-Sendfile")
    "a 304 for a static file drops X-Sendfile")
  (assert-false test
    (Map.contains?
      (Response.headers
        &(static-resp
          "GET /static/index.html HTTP/1.1\r\nRange: bytes=0-1\r\nIf-Modified-Since: Fri, 31 Dec 2100 23:59:59 GMT\r\n\r\n"))
      "X-Sendfile-Range")
    "a 304 for a static file drops the X-Sendfile-Range marker")

  ; -- No 304 when ETags differ --
  (assert-equal test
    200
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"ETag"
                                                   @"\"abc\""))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"xyz\"\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "mismatched If-None-Match returns 200")

  ; -- IMF-fixdate formatter --
  (assert-equal test
    "Thu, 01 Jan 1970 00:00:00 GMT"
    &(web-http-date 0l)
    "http-date formats the epoch")
  (assert-equal test
    "Wed, 21 Oct 2015 07:28:00 GMT"
    &(web-http-date 1445412480l)
    "http-date formats a post-2000 date with the right weekday")
  (assert-equal test
    "Tue, 29 Feb 2000 00:00:00 GMT"
    &(web-http-date 951782400l)
    "http-date formats a leap day")

  ; -- IMF-fixdate parser --
  (assert-equal test
    1445412480l
    (match (web-parse-http-date "Wed, 21 Oct 2015 07:28:00 GMT")
      (Maybe.Just s) s
      (Maybe.Nothing) -1l)
    "parse-http-date inverts the formatter")
  (assert-true test
    (Maybe.nothing? &(web-parse-http-date "not a date"))
    "parse-http-date rejects a malformed value")

  ; -- Date header --
  (assert-true test
    (Map.contains?
      (Response.headers &(web-finalize-response (Response.text @"hi") true))
      "Date")
    "finalize adds a Date header")

  ; -- Last-Modified on a static file response --
  (assert-true test
    (Map.contains?
      (Response.headers &(static-resp "GET /static/index.html HTTP/1.1\r\n\r\n"))
      "Last-Modified")
    "static file response carries Last-Modified")

  ; -- If-Modified-Since: 304 when not newer, 200 when newer (same resource) --
  (assert-equal test
    304
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"Last-Modified"
                                                   (web-http-date 1445412480l)))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-Modified-Since: Wed, 21 Oct 2015 07:28:00 GMT\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "If-Modified-Since not older than Last-Modified returns 304")
  (assert-equal test
    200
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"Last-Modified"
                                                   (web-http-date 1445412480l)))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-Modified-Since: Thu, 01 Jan 1970 00:00:00 GMT\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "If-Modified-Since older than Last-Modified returns 200")

  ; -- malformed If-Modified-Since is ignored --
  (assert-equal test
    200
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (Response.with-header (Response.text @"hi")
                                                   @"Last-Modified"
                                                   (web-http-date 1445412480l)))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-Modified-Since: not a date\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "malformed If-Modified-Since is ignored (200)")

  ; -- If-None-Match takes precedence over If-Modified-Since --
  (assert-equal test
    200
    (let [app (-> (App.create)
                  (App.GET @"/"
                           (fn [r p]
                             (-> (Response.text @"hi")
                                 (Response.with-header @"ETag" @"\"abc\"")
                                 (Response.with-header @"Last-Modified"
                                                       (web-http-date 1445412480l))))))
          req @"GET / HTTP/1.1\r\nHost: x\r\nIf-None-Match: \"xyz\"\r\nIf-Modified-Since: Wed, 21 Oct 2015 07:28:00 GMT\r\n\r\n"
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app &bh &ah &(String.to-bytes &req))]
      @(Response.code (Pair.a &pair)))
    "If-None-Match precedence: mismatch serves 200 despite matching If-Modified-Since")

  ; -- finalize preserves explicit Content-Length --
  (assert-true test
    (let [resp (-> (Response.text @"")
                   (Response.with-header @"Content-Length" @"42"))
          final (web-finalize-response resp true)
          cl (Map.get-with-default (Response.headers &final)
                                   "Content-Length"
                                   &[@"0"])]
      (= (Array.unsafe-first &cl) "42"))
    "finalize preserves explicit Content-Length")

  ; -- valid-method? --
  (assert-true test (web-valid-method? "GET") "valid-method? accepts GET")

  (assert-true test (web-valid-method? "POST") "valid-method? accepts POST")

  (assert-true test
    (web-valid-method? "OPTIONS")
    "valid-method? accepts OPTIONS")

  (assert-false test
    (web-valid-method? "BREW")
    "valid-method? rejects unknown method")

  (assert-false test (web-valid-method? "") "valid-method? rejects empty string")

  ; -- validate-request-line: valid requests --
  (assert-true test
    (Maybe.nothing?
      &(web-validate-request-line
        &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n\r\n")))
    "validate accepts valid GET request")

  (assert-true test
    (Maybe.nothing?
      &(web-validate-request-line
        &(String.to-bytes "POST /data HTTP/1.0\r\nHost: x\r\n\r\n")))
    "validate accepts HTTP/1.0 POST")

  (assert-true test
    (Maybe.nothing?
      &(web-validate-request-line
        &(String.to-bytes "DELETE /item/42 HTTP/1.1\r\nHost: x\r\n\r\n")))
    "validate accepts DELETE with path")

  ; -- validate-request-line: bad HTTP version --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line
        &(String.to-bytes "GET / HTTP/2.0\r\nHost: x\r\n\r\n")))
    "validate rejects HTTP/2.0")

  (assert-true test
    (Maybe.just?
      &(web-validate-request-line
        &(String.to-bytes "GET / BLAH\r\nHost: x\r\n\r\n")))
    "validate rejects non-HTTP version")

  ; -- validate-request-line: unknown method --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line
        &(String.to-bytes "BREW / HTTP/1.1\r\nHost: x\r\n\r\n")))
    "validate rejects unknown method BREW")

  ; -- validate-request-line: missing version --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line &(String.to-bytes "GET /\r\nHost: x\r\n\r\n")))
    "validate rejects missing version")

  ; -- validate-request-line: no spaces --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line &(String.to-bytes "GARBAGE\r\n\r\n")))
    "validate rejects request line without spaces")

  ; -- validate-request-line: no CRLF --
  (assert-true test
    (Maybe.just?
      &(web-validate-request-line &(String.to-bytes "GET / HTTP/1.1")))
    "validate rejects missing CRLF")

  ; -- build-response returns 400 for malformed request --
  (assert-equal test
    400
    (let [app (-> (App.create) (App.GET @"/" (fn [r p] (Response.text @"hi"))))
          bh (the
            (Array (Fn [&Request &(Map String String)] (Maybe Response)))
            [])
          ah (the
            (Array (Fn [&Request &(Map String String) Response] Response))
            [])
          pair (web-build-response &app
                                   &bh
                                   &ah
                                   &(String.to-bytes "INVALID\r\n\r\n"))]
      @(Response.code (Pair.a &pair)))
    "build-response returns 400 for garbage input")

  ; -- has-header-end --
  (assert-false test
    (web-has-header-end &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n"))
    "has-header-end is false while headers are still arriving")

  (assert-true test
    (web-has-header-end &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
    "has-header-end is true once the blank line lands")

  (assert-equal test
    23
    (web-header-end-index
      &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n\r\nbody"))
    "header-end-index points at the CRLFCRLF")

  ; -- request-complete?: requests without a body --
  (assert-equal test
    0
    (web-request-complete? &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n"))
    "incomplete headers need more bytes")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
    "GET without a body is complete")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "HEAD / HTTP/1.1\r\nHost: x\r\n\r\n"))
    "HEAD without a body is complete")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "GET /ws HTTP/1.1\r\nUpgrade: websocket\r\nSec-WebSocket-Key: k\r\nSec-WebSocket-Version: 13\r\n\r\n"))
    "WebSocket upgrade request is complete")

  ; -- request-complete?: Content-Length --
  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: 0\r\n\r\n"))
    "Content-Length: 0 is complete")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nab"))
    "a partial body needs more bytes")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nabcde"))
    "an exact body is complete")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes "GET / HTTP/1.1\r\nContent-Length: 3\r\n\r\n"))
    "a GET that declares a body waits for it")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\ncontent-length: 5\r\n\r\nab"))
    "header names are matched case-insensitively")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nX-Content-Length: 99\r\n\r\n"))
    "a header merely ending in content-length is not Content-Length")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nContent-Length: 20\r\n\r\nab\r\n\r\ncd"))
    "a CRLFCRLF inside the body does not end the wait")

  (assert-true test
    (let [full (String.append
            "POST /u HTTP/1.1\r\nContent-Length: 12\r\n\r\n"
            "hello world!")]
      (and
        (= 0
           (web-request-complete? &(String.to-bytes &(String.prefix &full 30))))
        (and
          (= 0
             (web-request-complete? &(String.to-bytes &(String.prefix &full 45))))
          (and
            (= 0
               (web-request-complete?
                 &(String.to-bytes &(String.prefix &full 50))))
            (= 1 (web-request-complete? &(String.to-bytes &full)))))))
    "a body arriving across three reads only completes on the last")

  (assert-true test
    (let [full (String.append
            &(String.append
              "POST / HTTP/1.1\r\nContent-Length: 5000\r\n\r\n"
              &(String.repeat 4056 "x"))
            &(String.repeat 944 "y"))]
      (and
        (= 0
           (web-request-complete? &(String.to-bytes &(String.prefix &full 4096))))
        (= 1 (web-request-complete? &(String.to-bytes &full)))))
    "a body straddling the 4096-byte read boundary is not truncated")

  ; -- request-complete?: malformed framing --
  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: abc\r\n\r\n"))
    "a non-numeric Content-Length is malformed")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: -5\r\n\r\n"))
    "a negative Content-Length is malformed")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 6\r\n\r\nabcde"))
    "a conflicting duplicate Content-Length is malformed")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nContent-Length: 5\r\nContent-Length: 5\r\n\r\nabcde"))
    "an identical duplicate Content-Length is accepted")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\nabcde"))
    "Content-Length together with Transfer-Encoding is malformed")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nTransfer-Encoding: gzip\r\n\r\n"))
    "a Transfer-Encoding not ending in chunked is malformed")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nContent-Length: 99999999999999\r\n\r\nx"))
    "an absurd Content-Length saturates instead of overflowing")

  ; -- request-complete?: chunked --
  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nabcde\r\n"))
    "a chunked body without its terminator needs more bytes")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nabcde\r\n0\r\n\r\n"))
    "a chunked body with its terminator is complete")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: gzip, chunked\r\n\r\n0\r\n\r\n"))
    "chunked as the final coding is honoured")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nTransfer-Encoding: xchunked\r\n\r\n"))
    "a coding merely ending in chunked is not chunked")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nabcde\r\n3\r\nxyz\r\n0\r\n\r\n"))
    "a chunked body of several chunks is complete")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nabc"))
    "a chunk whose data has not all arrived needs more bytes")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\nExpires: x\r\n\r\n"))
    "a chunked body with a trailer section is complete")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\nExpires: x\r\n"))
    "a trailer section without its blank line needs more bytes")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0;n=v\r\n\r\n"))
    "a chunk extension on the last chunk is skipped")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\n\r\n0\r\n\r\n0\r\n\r\n"))
    "chunk data holding the terminator bytes does not end the wait early")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nzz\r\nabcde\r\n0\r\n\r\n"))
    "a non-hexadecimal chunk size is malformed")

  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nabcdeXX0\r\n\r\n"))
    "chunk data not followed by CRLF is malformed")

  (assert-equal test
    0
    (web-request-complete?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\nffffffffffffffff\r\nx\r\n0\r\n\r\n"))
    "an absurd chunk size saturates instead of overflowing")

  ; -- request-complete?: whitespace before a colon (RFC 7230 §3.2.4) --
  (assert-equal test
    -1
    (web-request-complete?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length : 5\r\n\r\nabcde"))
    "whitespace between a field name and its colon is malformed")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "GET http://h:80/p HTTP/1.1\r\nHost: x\r\n\r\n"))
    "a colon in the request line is not a header colon")

  (assert-equal test
    1
    (web-request-complete?
      &(String.to-bytes "GET / HTTP/1.1\r\nX-Note: a : b\r\n\r\n"))
    "a space before a colon inside a value is fine")

  ; -- request-complete?: resuming the chunk walk across reads --
  (assert-equal test
    1
    (replay-status
      "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n1\r\nb\r\n0\r\n\r\n"
      1)
    "a chunked body arriving one byte at a time still completes")

  (assert-equal test
    1
    (replay-status
      "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhi\r\n0\r\nA: 1\r\nB: 2\r\n\r\n"
      3)
    "a trailer section arriving across reads still completes")

  (assert-equal test
    0
    (replay-status
      "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nhi\r\n0\r\nA: 1\r\n"
      3)
    "an unterminated trailer section keeps needing bytes across reads")

  (assert-equal test
    0
    (replay-status
      "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n5\r\n\r\n0\r\n\r\n"
      1)
    "resuming does not let terminator bytes in chunk data end the wait early")

  (assert-equal test
    -1
    (replay-status
      "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n2\r\nab\r\nzz\r\n"
      2)
    "malformed framing is still caught when the walk resumes")

  (assert-equal test
    0
    @(Pair.b
      &(web-request-status
        &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\nab")
        0))
    "a Content-Length request never records a chunk cursor")

  (assert-equal test
    1
    @(Pair.a
      &(web-request-status
        &(String.to-bytes
          "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")
        9999))
    "a cursor past the end of the buffer is ignored")

  (assert-equal test
    1
    @(Pair.a
      &(web-request-status
        &(String.to-bytes
          "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n")
        2))
    "a cursor pointing before the body is ignored")

  ; tripwires: in-range stale cursors answer wrongly by design — safety is
  ; the caller's cursor resets, not this range check
  (assert-equal test
    0
    @(Pair.a
      &(web-request-status
        &(String.to-bytes
          "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n")
        0))
    "a truncated chunked body is incomplete from a fresh cursor")

  (assert-equal test
    1
    @(Pair.a
      &(web-request-status
        &(String.to-bytes
          "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n")
        -51))
    "an in-range stale trailer cursor reports that truncated body as complete")

  (assert-equal test
    -1
    @(Pair.a
      &(web-request-status
        &(String.to-bytes
          "POST / HTTP/1.1\r\nTransfer-Encoding: chunked\r\n\r\n1\r\na\r\n")
        48))
    "an in-range stale chunk cursor reports that truncated body as malformed")

  ; -- wants-continue?: the 100 Continue gate (RFC 7231 §5.1.1) --
  (assert-true test
    (web-wants-continue?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nExpect: 100-continue\r\nContent-Length: 5\r\n\r\n"))
    "an HTTP/1.1 request with Expect: 100-continue wants a 100")

  (assert-true test
    (web-wants-continue?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nexpect: 100-Continue\r\nContent-Length: 5\r\n\r\n"))
    "the Expect header and its value are matched case-insensitively")

  (assert-false test
    (web-wants-continue?
      &(String.to-bytes "POST / HTTP/1.1\r\nContent-Length: 5\r\n\r\n"))
    "a request without Expect wants no 100")

  (assert-false test
    (web-wants-continue?
      &(String.to-bytes
        "POST / HTTP/1.0\r\nExpect: 100-continue\r\nContent-Length: 5\r\n\r\n"))
    "an HTTP/1.0 request wants no 100")

  (assert-false test
    (web-wants-continue?
      &(String.to-bytes
        "POST / HTTP/1.1\r\nExpect: 200-ok\r\nContent-Length: 5\r\n\r\n"))
    "an unknown expectation wants no 100")

  (assert-false test
    (web-wants-continue?
      &(String.to-bytes "POST / HTTP/1.1\r\nExpect: 100-continue\r\n"))
    "incomplete headers want no 100 yet")

  ; -- http-timeout-close?: the request lifecycle timeouts --
  (assert-false test
    (App.http-timeout-close? 1000 1010 15 60 10 60)
    "headers still arriving inside header-timeout stay open")

  (assert-true test
    (App.http-timeout-close? 1000 1016 15 60 10 60)
    "headers still arriving past header-timeout close")

  (assert-false test
    (App.http-timeout-close? -1000 1050 15 60 10 60)
    "a body still arriving inside request-timeout stays open")

  (assert-true test
    (App.http-timeout-close? -1000 1061 15 60 10 60)
    "a body dripping past request-timeout closes")

  (assert-false test
    (App.http-timeout-close? -1000 1020 15 60 10 60)
    "the header-timeout does not apply once the headers are complete")

  (assert-true test
    (App.http-timeout-close? 0 1000 15 60 61 60)
    "an idle connection with no request in flight closes")

  (assert-false test
    (App.http-timeout-close? 0 1000 15 60 59 60)
    "a connection inside idle-timeout stays open")

  ; -- StaticFile.exists? --
  (assert-true test
    (StaticFile.exists? "test/static-fixtures/index.html")
    "exists? finds an existing file")

  (assert-false test
    (StaticFile.exists? "test/static-fixtures/nonexistent.xyz")
    "exists? returns false for missing file")

  (assert-false test
    (StaticFile.exists? "test/static-fixtures/sub")
    "exists? returns false for a directory")

  ; -- StaticFile.find-index --
  (assert-true test
    (Maybe.just?
      &(StaticFile.find-index "test/static-fixtures" &[@"index.html"]))
    "find-index finds index.html in root")

  (assert-true test
    (Maybe.just?
      &(StaticFile.find-index "test/static-fixtures/sub" &[@"index.html"]))
    "find-index finds index.html in subdirectory")

  (assert-true test
    (Maybe.nothing?
      &(StaticFile.find-index "test/static-fixtures" &[@"default.htm"]))
    "find-index returns Nothing when no index matches")

  (assert-true test
    (Maybe.just?
      &(StaticFile.find-index "test/static-fixtures"
                              &[@"missing.htm" @"index.html"]))
    "find-index tries files in order and finds second")

  ; -- StaticFile.serve: path traversal --
  (assert-equal test
    404
    @(Response.code
      &(StaticFile.serve "test/static-fixtures" "../web.carp" &[@"index.html"]))
    "serve rejects .. traversal")

  (assert-equal test
    404
    @(Response.code
      &(StaticFile.serve "test/static-fixtures"
                         "sub/../../web.carp"
                         &[@"index.html"]))
    "serve rejects nested .. traversal")

  ; -- StaticFile.serve: file serving --
  (assert-equal test
    200
    @(Response.code
      &(StaticFile.serve "test/static-fixtures" "sub/style.css" &[@"index.html"]))
    "serve returns 200 for existing file")

  (assert-true test
    (let [resp (StaticFile.serve "test/static-fixtures"
                                 "sub/style.css"
                                 &[@"index.html"])
          ct (Map.get-with-default (Response.headers &resp)
                                   "Content-Type"
                                   &[@""])]
      (= (Array.unsafe-first &ct) "text/css; charset=utf-8"))
    "serve sets correct Content-Type for .css")

  (assert-true test
    (Map.contains?
      (Response.headers
        &(StaticFile.serve "test/static-fixtures"
                           "sub/style.css"
                           &[@"index.html"]))
      "X-Sendfile")
    "serve uses X-Sendfile header")

  ; -- StaticFile.serve: index files --
  (assert-equal test
    200
    @(Response.code
      &(StaticFile.serve "test/static-fixtures" "" &[@"index.html"]))
    "serve finds index.html for empty path")

  (assert-equal test
    200
    @(Response.code
      &(StaticFile.serve "test/static-fixtures" "sub/" &[@"index.html"]))
    "serve finds index.html for trailing-slash path")

  (assert-equal test
    200
    @(Response.code
      &(StaticFile.serve "test/static-fixtures" "sub" &[@"index.html"]))
    "serve tries index files when path is a directory")

  ; -- StaticFile.serve: 404 --
  (assert-equal test
    404
    @(Response.code
      &(StaticFile.serve "test/static-fixtures"
                         "nonexistent.txt"
                         &[@"index.html"]))
    "serve returns 404 for missing file")

  ; -- StaticFile.mount --
  (assert-equal test
    1
    (let [app (-> (App.create) (StaticFile.mount @"/assets" @"./public"))]
      (Array.length (App.routes &app)))
    "mount adds one route to app")

  ; -- HMAC-SHA1 --
  (assert-equal test
    40
    (String.length
      &(HMAC.sha1-hex &(String.to-bytes "key") &(String.to-bytes "msg")))
    "HMAC-SHA1 returns 40-char hex string")

  (assert-equal test
    &(HMAC.sha1-hex &(String.to-bytes "key") &(String.to-bytes "msg"))
    &(HMAC.sha1-hex &(String.to-bytes "key") &(String.to-bytes "msg"))
    "HMAC-SHA1 is deterministic")

  (assert-true test
    (/=
      &(HMAC.sha1-hex &(String.to-bytes "key1") &(String.to-bytes "msg"))
      &(HMAC.sha1-hex &(String.to-bytes "key2") &(String.to-bytes "msg")))
    "HMAC-SHA1 different keys produce different digests")

  (assert-true test
    (/=
      &(HMAC.sha1-hex &(String.to-bytes "key") &(String.to-bytes "msg1"))
      &(HMAC.sha1-hex &(String.to-bytes "key") &(String.to-bytes "msg2")))
    "HMAC-SHA1 different messages produce different digests")

  ; -- HMAC-SHA1 RFC 2202 known-answer --
  (assert-equal test
    "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"
    &(HMAC.sha1-hex &(String.to-bytes "Jefe")
                    &(String.to-bytes "what do ya want for nothing?"))
    "HMAC-SHA1 matches RFC 2202 test vector 2")

  ; -- Request.cookies-map --
  (assert-equal test
    "abc"
    &(Map.get
      &(Request.cookies-map
        &(Result.unsafe-from-success
          (Request.parse
            "GET / HTTP/1.1\r\nCookie: session=abc; lang=en\r\n\r\n")))
      "session")
    "cookies-map extracts session cookie")

  (assert-equal test
    "en"
    &(Map.get
      &(Request.cookies-map
        &(Result.unsafe-from-success
          (Request.parse
            "GET / HTTP/1.1\r\nCookie: session=abc; lang=en\r\n\r\n")))
      "lang")
    "cookies-map extracts second cookie")

  (assert-equal test
    0
    (Map.length
      &(Request.cookies-map
        &(Result.unsafe-from-success
          (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))))
    "cookies-map returns empty map when no cookies")

  ; -- Request.cookie --
  (assert-equal test
    "abc"
    &(Maybe.unsafe-from
      (Request.cookie
        &(Result.unsafe-from-success
          (Request.parse
            "GET / HTTP/1.1\r\nCookie: session=abc; lang=en\r\n\r\n"))
        "session"))
    "cookie extracts value by name")

  (assert-true test
    (Maybe.nothing?
      &(Request.cookie
        &(Result.unsafe-from-success
          (Request.parse "GET / HTTP/1.1\r\nHost: x\r\n\r\n"))
        "missing"))
    "cookie returns Nothing for missing name")

  ; -- Cookie.sign / Cookie.verify --
  (assert-true test
    (do
      (Cookie.set-secret @"test-secret")
      (let [signed &(Cookie.sign "hello")]
        (and (String.starts-with? signed "hello.") (= (String.length signed) 46))))
    "sign produces value.40-char-hex format")

  (assert-equal test
    "hello"
    &(do
      (Cookie.set-secret @"test-secret")
      (let [signed (Cookie.sign "hello")]
        (Maybe.unsafe-from (Cookie.verify &signed))))
    "verify round-trips with sign")

  (assert-true test
    (do
      (Cookie.set-secret @"test-secret")
      (let [signed (Cookie.sign "hello")
            len (String.length &signed)
            tampered &(String.append "tampered"
                                     &(String.byte-slice &signed 5 len))]
        (Maybe.nothing? &(Cookie.verify tampered))))
    "verify rejects tampered value")

  (assert-true test
    (do
      (Cookie.set-secret @"test-secret")
      (Maybe.nothing? &(Cookie.verify "short")))
    "verify rejects too-short input")

  (assert-true test
    (do
      (Cookie.set-secret @"secret-a")
      (let-do [signed (Cookie.sign "hello")]
        (Cookie.set-secret @"secret-b")
        (Maybe.nothing? &(Cookie.verify &signed))))
    "verify rejects value signed with different secret")

  ; -- Request.signed-cookie --
  (assert-equal test
    "session123"
    &(do
      (Cookie.set-secret @"test-secret")
      (let [signed-val (Cookie.sign "session123")
            raw (fmt "GET / HTTP/1.1\r\nCookie: tok=%s\r\n\r\n" &signed-val)
            req (Result.unsafe-from-success (Request.parse &raw))]
        (Maybe.unsafe-from (Request.signed-cookie &req "tok"))))
    "signed-cookie verifies and returns original value")

  ; -- Response.set-cookie-with-max-age --
  (assert-true test
    (let [resp (Response.set-cookie-with-max-age (Response.text @"ok")
                                                 (Cookie.init @"prefs"
                                                              @"dark"
                                                              @"/"
                                                              (Maybe.Nothing)
                                                              (Maybe.Nothing)
                                                              false
                                                              false
                                                              (SameSite.Lax))
                                                 86400)
          vals (Map.get-with-default (Response.headers &resp) "Set-Cookie" &[])
          hdr (Array.unsafe-first &vals)]
      (>= (String.index-of-string hdr "Max-Age=86400") 0))
    "set-cookie-with-max-age includes Max-Age attribute")

  ; -- Response.clear-cookie --
  (assert-true test
    (let [resp (Response.clear-cookie (Response.text @"bye") @"session" @"/")
          vals (Map.get-with-default (Response.headers &resp) "Set-Cookie" &[])
          hdr (Array.unsafe-first &vals)]
      (and (String.starts-with? hdr "session=;")
           (>= (String.index-of-string hdr "Max-Age=0") 0)))
    "clear-cookie sets empty value and Max-Age=0")

  ; -- SSE.data --
  (assert-equal test
    "data: hello\n\n"
    &(SSE.data "hello")
    "data encodes a data-only event")

  (assert-equal test
    "data: \n\n"
    &(SSE.data "")
    "an empty payload still emits a data line")

  (assert-equal test
    "data: a\ndata: b\n\n"
    &(SSE.data "a\nb")
    "a multi-line payload becomes one data line per line")

  (assert-equal test
    "data: a\ndata: b\n\n"
    &(SSE.data "a\r\nb")
    "CRLF separates data lines")

  (assert-equal test
    "data: a\ndata: b\n\n"
    &(SSE.data "a\rb")
    "a lone CR separates data lines")

  (assert-equal test
    "data: a\ndata: \n\n"
    &(SSE.data "a\n")
    "a trailing newline emits a trailing empty data line")

  ; -- SSE.event, SSE.encode, SSE.retry-after --
  (assert-equal test
    "event: tick\ndata: 1\n\n"
    &(SSE.event "tick" "1")
    "event encodes a named event")

  (assert-equal test
    "id: 7\nevent: tick\nretry: 2500\ndata: x\n\n"
    &(SSE.encode (Maybe.Just @"tick") "x" (Maybe.Just @"7") (Maybe.Just 2500))
    "encode emits id, event and retry ahead of the data lines")

  (assert-equal test
    "retry: 5000\n\n"
    &(SSE.retry-after 5000)
    "retry-after encodes a lone reconnection time")

  ; -- SSE.comment-line --
  (assert-equal test
    ": ping\n\n"
    &(SSE.comment-line "ping")
    "comment-line encodes a comment")

  ; -- SSE framing: no raw CR or LF survives a field value --
  (assert-equal test
    "event: ab\ndata: c\n\n"
    &(SSE.event "a\r\nb" "c")
    "an event name loses its line breaks")

  (assert-equal test
    "id: 12\ndata: x\n\n"
    &(SSE.encode (Maybe.Nothing) "x" (Maybe.Just @"1\n2") (Maybe.Nothing))
    "an id loses its line breaks")

  (assert-equal test
    ": ab\n\n"
    &(SSE.comment-line "a\nb")
    "a comment loses its line breaks")

  (assert-true test
    (< (String.index-of-string &(SSE.data "a\r\nb\rc\nd") "\r") 0)
    "no carriage return survives an encoded payload")

  ; -- SSEStream outbox --
  (assert-equal test
    "data: a\n\nevent: e\ndata: b\n\n"
    &(let-do [s (SSEStream.init 0 (Maybe.Nothing) [])
              buf (the (Array Byte) [])]
       (SSEStream.send &s "a")
       (SSEStream.send-event &s "e" "b")
       (App.sse-flatten-outbox &s &buf)
       (String.from-bytes &buf))
    "the outbox flattens in queue order")

  ; -- web-try-sse --
  (assert-equal test
    0
    (sse-idx &(sse-match "GET /events HTTP/1.1\r\nHost: x\r\n\r\n" "/events"))
    "a GET on an SSE path matches its route")

  (assert-equal test
    -1
    (sse-idx &(sse-match "POST /events HTTP/1.1\r\nHost: x\r\n\r\n" "/events"))
    "only GET opens a stream")

  (assert-equal test
    -1
    (sse-idx &(sse-match "GET /other HTTP/1.1\r\nHost: x\r\n\r\n" "/events"))
    "an unmatched path is not a stream")

  (assert-equal test
    -1
    (sse-idx
      &(web-try-sse &(String.to-bytes "GET /events HTTP/1.1\r\nHost: x\r\n\r\n")
                    &(the (Array SSERoute) [])))
    "an app without SSE routes never opens a stream")

  (assert-equal test
    "none"
    &(sse-last-id &(sse-match "GET /events HTTP/1.1\r\nHost: x\r\n\r\n"
                              "/events"))
    "a fresh stream carries no Last-Event-ID")

  (assert-equal test
    "42"
    &(sse-last-id &(sse-match "GET /events HTTP/1.1\r\nlast-event-id: 42\r\n\r\n"
                              "/events"))
    "Last-Event-ID is read case-insensitively")

  (assert-equal test
    "9"
    &(sse-param &(sse-match "GET /rooms/9/events HTTP/1.1\r\nHost: x\r\n\r\n"
                            "/rooms/:room/events")
                "room")
    "path parameters are captured for a stream")

  ; -- App.SSE --
  (assert-equal test
    1
    (Array.length
      (App.sse-routes &(App.SSE (App.create)
                                @"/events"
                                (fn [event params s] ()))))
    "SSE registers a stream route")

  (assert-equal test
    0
    (Array.length
      (App.routes &(App.SSE (App.create) @"/events" (fn [event params s] ()))))
    "SSE does not add an HTTP route"))
